cess: true, id: newId}))\n    .setMimeType(ContentService.MimeType.JSON);\n}\n\nfunction updateData(sheet, id, params) {\n  var data = sheet.getDataRange().getValues();\n  for (var i = 1; i < data.length; i++) {\n    if (data[i][0] == id) {\n      sheet.getRange(i + 1, 2).setValue(params.nombre);\n      sheet.getRange(i + 1, 3).setValue(params.dni);\n      sheet.getRange(i + 1, 4).setValue(parseInt(params.diasDisponibles));\n      sheet.getRange(i + 1, 5).setValue(params.fechaInicio);\n      sheet.getRange(i + 1, 6).setValue(params.dias);\n      sheet.getRange(i + 1, 7).setValue(params.franja1);\n      sheet.getRange(i + 1, 8).setValue(params.franja2);\n      break;\n    }\n  }\n  return ContentService.createTextOutput(JSON.stringify({success: true}))\n    .setMimeType(ContentService.MimeType.JSON);\n}\n\nfunction deleteData(sheet, id) {\n  var data = sheet.getDataRange().getValues();\n  for (var i = 1; i < data.length; i++) {\n    if (data[i][0] == id) {\n      sheet.deleteRow(i + 1);\n      break;\n    }\n  }\n  return ContentService.createTextOutput(JSON.stringify({success: true}))\n    .setMimeType(ContentService.MimeType.JSON);\n}\n```\n\n3. Hacé clic en **Guardar** (o `Ctrl + S`).\n\n## Paso 2: Publicar el script\n\n1. Hacé clic en **\"Implementar\"** (arriba a la derecha) → **\"Nueva implementación\"**.\n2. Seleccioná **\"Aplicación web\"**.\n3. En \"Ejecutar como\", seleccioná **\"Yo\"**.\n4. En \"Quién tiene acceso\", seleccioná **\"Cualquier persona\"**.\n5. Hacé clic en **\"Implementar\"**.\n6. Si te pide permiso, hacé clic en **\"Permitir\"**.\n7. Te va a dar una URL que empieza con `https://script.google.com/macros/s/...`\n\n## Paso 3: Copiarme la URL\n\nCopiá esa URL completa y pegámelo acá.\n\n---\n\n¿Lograste crear el script y obtener la URL?"
