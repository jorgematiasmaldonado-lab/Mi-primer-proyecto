 .dias-agotados {\n    color: #fc8181;\n    font-weight: 600;\n}\n\n/* Estilos para impresión */\n@media print {\n    body * {\n        visibility: hidden;\n    }\n\n    .modal,\n    .modal * {\n        visibility: visible;\n    }\n\n    .modal {\n        position: absolute;\n        top: 0;\n        left: 0;\n        width: 100%;\n        height: auto;\n        background: white;\n        padding: 0;\n    }\n\n    .modal-contenido {\n        background: white;\n        border: none;\n        max-width: 100%;\n        max-height: none;\n        overflow: visible;\n        color: black;\n    }\n\n    .modal-header h2 {\n        color: black;\n    }\n\n    .modal-acciones {\n        display: none;\n    }\n\n    .btn-cerrar-modal {\n        display: none;\n    }\n\n    .modal-tabla th {\n        background: #e2e8f0;\n        color: black;\n    }\n\n    .modal-tabla td {\n        color: black;\n        border-bottom: 1px solid #ccc;\n    }\n\n    .modal-tabla .sin-franja {\n        color: #666;\n    }\n\n    .modal-tabla .dias-restantes,\n    .modal-tabla .dias-agotados {\n        color: black;\n    }\n}\n\n@media (max-width: 480px) {\n    body {\n        padding: 12px;\n    }\n\n    .logo {\n        font-size: 2rem;\n        letter-spacing: 6px;\n    }\n\n    header h1 {\n        font-size: 1rem;\n    }\n\n    .form-section, .list-section {\n        padding: 18px;\n    }\n\n    .form-row {\n        flex-direction: column;\n        gap: 0;\n    }\n\n    .dia {\n        min-height: 40px;\n    }\n\n    .dia .apellido {\n        font-size: 0.55rem;\n    }\n\n    .list-header {\n        flex-direction: column;\n        gap: 10px;\n        align-items: flex-start;\n    }\n\n    .modal-acciones {\n        flex-direction: column;\n    }\n\n    .btn-exportar, .btn-imprimir {\n        width: 100%;\n    }\n}\n"
