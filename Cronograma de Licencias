           border-bottom: 2px solid #4a5568;\n            padding-bottom: 8px;\n        }\n\n        .form-group {\n            margin-bottom: 16px;\n        }\n\n        .form-row {\n            display: flex;\n            gap: 12px;\n        }\n\n        .form-row .form-group {\n            flex: 1;\n        }\n\n        label {\n            display: block;\n            margin-bottom: 6px;\n            font-weight: 600;\n            font-size: 0.85rem;\n            color: #a0aec0;\n            text-transform: uppercase;\n            letter-spacing: 0.5px;\n        }\n\n        input {\n            width: 100%;\n            padding: 12px 14px;\n            background: #1a202c;\n            border: 2px solid #4a5568;\n            border-radius: 8px;\n            font-size: 1rem;\n            color: #e2e8f0;\n            transition: border-color 0.2s;\n        }\n\n        input:focus {\n            outline: none;\n            border-color: #63b3ed;\n        }\n\n        input::placeholder {\n            color: #4a5568;\n        }\n\n        .help-text {\n            font-size: 0.8rem;\n            color: #718096;\n            margin-bottom: 10px;\n        }\n\n        .calendar-nav {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            margin-bottom: 12px;\n        }\n\n        .btn-nav {\n            padding: 8px 14px;\n            background: #1a202c;\n            border: 1px solid #4a5568;\n            border-radius: 6px;\n            cursor: pointer;\n            font-size: 0.8rem;\n            color: #a0aec0;\n            transition: all 0.2s;\n        }\n\n        .btn-nav:hover {\n            background: #2d3748;\n            color: #e2e8f0;\n        }\n\n        .mes-label {\n            font-weight: 600;\n            color: #e2e8f0;\n            font-size: 0.95rem;\n        }\n\n        .calendario {\n            display: grid;\n            grid-template-columns: repeat(7, minmax(0, 1fr));\n            gap: 3px;\n            margin-bottom: 12px;\n            width: 100%;\n        }\n\n        .dia-header {\n            text-align: center;\n            font-size: 0.7rem;\n            font-weight: 600;\n            color: #718096;\n            padding: 6px 0;\n            text-transform: uppercase;\n        }\n\n        .dia {\n            min-height: 50px;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            border-radius: 6px;\n            font-size: 0.85rem;\n            padding: 2px;\n            position: relative;\n            cursor: pointer;\n        }\n\n        .dia.vacio {\n            background: transparent;\n            min-height: 0;\n            cursor: default;\n        }\n\n        .dia.libre {\n            background: #1a202c;\n            color: #4a5568;\n        }\n\n        .dia.franja1 {\n            background: #2b6cb0;\n            color: #ffffff;\n            font-weight: 600;\n        }\n\n        .dia.franja2 {\n            background: #2f855a;\n            color: #ffffff;\n            font-weight: 600;\n        }\n\n        .dia.ocupado-otro {\n            background: #742a2a;\n            color: #feb2b2;\n        }\n\n        .dia.prohibido {\n            background: #c53030;\n            color: #ffffff;\n            font-weight: 700;\n            border: 2px solid #fc8181;\n        }\n\n        .dia.feriado {\n            background: #744210;\n            color: #fbd38d;\n        }\n\n        .dia .numero {\n            font-weight: 600;\n            font-size: 0.85rem;\n        }\n\n        .dia .apellido {\n            font-size: 0.6rem;\n            margin-top: 1px;\n            text-align: center;\n            line-height: 1;\n            max-width: 100%;\n            overflow: hidden;\n            text-overflow: ellipsis;\n            white-space: nowrap;\n        }\n\n        .dia.franja1 .apellido,\n        .dia.franja2 .apellido {\n            color: rgba(255,255,255,0.85);\n        }\n\n        .dia.ocupado-otro .apellido {\n            color: #feb2b2;\n        }\n\n        .dia.prohibido .apellido {\n            color: #ffffff;\n        }\n\n        .tooltip {\n            position: fixed;\n            background: #1a202c;\n            border: 1px solid #4a5568;\n            border-radius: 8px;\n            padding: 12px 16px;\n            font-size: 0.85rem;\n            color: #e2e8f0;\n            pointer-events: none;\n            z-index: 1000;\n            max-width: 250px;\n            box-shadow: 0 4px 20px rgba(0,0,0,0.5);\n            display: none;\n        }\n\n        .tooltip.visible {\n            display: block;\n        }\n\n        .tooltip .fecha {\n            font-weight: 600;\n            color: #63b3ed;\n            margin-bottom: 6px;\n            font-size: 0.9rem;\n        }\n\n        .tooltip .feriado {\n            color: #fbd38d;\n            font-weight: 600;\n            margin-bottom: 6px;\n            font-size: 0.85rem;\n        }\n\n        .tooltip .prohibido {\n            color: #fc8181;\n            font-weight: 600;\n            margin-bottom: 6px;\n            font-size: 0.85rem;\n        }\n\n        .tooltip .persona {\n            padding: 4px 0;\n            border-bottom: 1px solid #2d3748;\n        }\n\n        .tooltip .persona:last-child {\n            border-bottom: none;\n        }\n\n        .tooltip .persona .nombre {\n            font-weight: 600;\n        }\n\n        .tooltip .persona .franja {\n            font-size: 0.75rem;\n            color: #718096;\n        }\n\n        .tooltip .sin-vacaciones {\n            color: #4a5568;\n            font-style: italic;\n        }\n\n        .leyenda {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 12px;\n            margin-bottom: 10px;\n        }\n\n        .item {\n            display: flex;\n            align-items: center;\n            gap: 6px;\n            font-size: 0.75rem;\n            color: #a0aec0;\n        }\n\n        .cuadrado {\n            width: 12px;\n            height: 12px;\n            border-radius: 3px;\n            display: inline-block;\n        }\n\n        .cuadrado.franja1 { background: #2b6cb0; }\n        .cuadrado.franja2 { background: #2f855a; }\n        .cuadrado.ocupado { background: #742a2a; }\n        .cuadrado.prohibido { background: #c53030; }\n        .cuadrado.feriado { background: #744210; }\n\n        .contador {\n            font-size: 0.85rem;\n            color: #a0aec0;\n        }\n\n        .contador strong {\n            color: #e2e8f0;\n        }\n\n        .ayuda-calendario {\n            font-size: 0.8rem;\n            color: #63b3ed;\n            margin-top: 8px;\n            font-style: italic;\n        }\n\n        .btn-submit {\n            width: 100%;\n            padding: 14px;\n            background: linear-gradient(135deg, #2b6cb0 0%, #2c5282 100%);\n            color: white;\n            border: none;\n            border-radius: 8px;\n            font-size: 0.95rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all 0.2s;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n        }\n\n        .btn-submit:hover {\n            background: linear-gradient(135deg, #3182ce 0%, #2b6cb0 100%);\n            transform: translateY(-1px);\n        }\n\n        .btn-cancelar {\n            width: 100%;\n            padding: 12px;\n            background: #1a202c;\n            color: #a0aec0;\n            border: 1px solid #4a5568;\n            border-radius: 8px;\n            font-size: 0.9rem;\n            font-weight: 600;\n            cursor: pointer;\n            margin-top: 8px;\n            transition: all 0.2s;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n        }\n\n        .btn-cancelar:hover {\n            background: #2d3748;\n            color: #e2e8f0;\n        }\n\n        .mensaje {\n            margin-top: 12px;\n            padding: 12px;\n            border-radius: 8px;\n            font-size: 0.85rem;\n            display: none;\n        }\n\n        .mensaje.error {\n            display: block;\n            background: #742a2a;\n            color: #feb2b2;\n            border: 1px solid #9b2c2c;\n        }\n\n        .mensaje.exito {\n            display: block;\n            background: #276749;\n            color: #9ae6b4;\n            border: 1px solid #2f855a;\n        }\n\n        .list-header {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            margin-bottom: 16px;\n            border-bottom: 2px solid #4a5568;\n            padding-bottom: 8px;\n        }\n\n        .list-header h2 {\n            margin-bottom: 0;\n            border-bottom: none;\n            padding-bottom: 0;\n        }\n\n        .btn-listado {\n            padding: 8px 16px;\n            background: #2b6cb0;\n            color: white;\n            border: none;\n            border-radius: 6px;\n            cursor: pointer;\n            font-size: 0.8rem;\n            font-weight: 600;\n            transition: background 0.2s;\n            text-transform: uppercase;\n            letter-spacing: 0.5px;\n        }\n\n        .btn-listado:hover {\n            background: #3182ce;\n        }\n\n        .lista {\n            display: flex;\n            flex-direction: column;\n            gap: 10px;\n        }\n\n        .efectivo {\n            display: flex;\n            align-items: center;\n            gap: 12px;\n            padding: 14px 16px;\n            background: #1a202c;\n            border-radius: 8px;\n            border-left: 4px solid #2b6cb0;\n        }\n\n        .efectivo.prohibido {\n            border-left-color: #c53030;\n            background: #2d1b1b;\n        }\n\n        .circulo {\n            width: 12px;\n            height: 12px;\n            border-radius: 50%;\n            background: #c53030;\n            flex-shrink: 0;\n            display: none;\n        }\n\n        .efectivo.prohibido .circulo {\n            display: block;\n        }\n\n        .info {\n            flex: 1;\n        }\n\n        .info .nombre {\n            font-weight: 600;\n            color: #e2e8f0;\n            font-size: 0.95rem;\n        }\n\n        .info .detalles {\n            font-size: 0.8rem;\n            color: #718096;\n            margin-top: 2px;\n        }\n\n        .badge {\n            font-size: 0.7rem;\n            padding: 4px 10px;\n            border-radius: 4px;\n            font-weight: 600;\n            background: #c53030;\n            color: white;\n            display: none;\n            text-transform: uppercase;\n        }\n\n        .efectivo.prohibido .badge {\n            display: inline-block;\n        }\n\n        .btn-eliminar {\n            padding: 6px 12px;\n            background: #742a2a;\n            color: #feb2b2;\n            border: none;\n            border-radius: 6px;\n            cursor: pointer;\n            font-size: 0.75rem;\n            font-weight: 600;\n            transition: background 0.2s;\n            text-transform: uppercase;\n        }\n\n        .btn-eliminar:hover {\n            background: #9b2c2c;\n        }\n\n        .btn-editar {\n            padding: 6px 12px;\n            background: #2b6cb0;\n            color: #bee3f8;\n            border: none;\n            border-radius: 6px;\n            cursor: pointer;\n            font-size: 0.75rem;\n            font-weight: 600;\n            transition: background 0.2s;\n            text-transform: uppercase;\n        }\n\n        .btn-editar:hover {\n            background: #3182ce;\n        }\n\n        .btn-detalles {\n            padding: 6px 12px;\n            background: #2d3748;\n            color: #a0aec0;\n            border: 1px solid #4a5568;\n            border-radius: 6px;\n            cursor: pointer;\n            font-size: 0.75rem;\n            font-weight: 600;\n            transition: all 0.2s;\n            text-transform: uppercase;\n        }\n\n        .btn-detalles:hover {\n            background: #4a5568;\n            color: #e2e8f0;\n        }\n\n        .detalles-expandidos {\n            margin-top: 10px;\n            padding: 14px;\n            background: #1a202c;\n            border-radius: 8px;\n            border: 1px solid #4a5568;\n            display: none;\n        }\n\n        .detalles-expandidos.visible {\n            display: block;\n        }\n\n        .detalles-expandidos h3 {\n            font-size: 0.85rem;\n            color: #a0aec0;\n            margin-bottom: 10px;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n        }\n\n        .detalles-expandidos .franja-info {\n            margin-bottom: 10px;\n            padding: 10px;\n            border-radius: 6px;\n            font-size: 0.85rem;\n        }\n\n        .detalles-expandidos .franja-info.franja1 {\n            background: rgba(43, 108, 176, 0.15);\n            border-left: 3px solid #2b6cb0;\n        }\n\n        .detalles-expandidos .franja-info.franja2 {\n            background: rgba(47, 133, 90, 0.15);\n            border-left: 3px solid #2f855a;\n        }\n\n        .detalles-expandidos .franja-info .titulo {\n            font-weight: 600;\n            margin-bottom: 4px;\n        }\n\n        .detalles-expandidos .franja-info.franja1 .titulo {\n            color: #63b3ed;\n        }\n\n        .detalles-expandidos .franja-info.franja2 .titulo {\n            color: #68d391;\n        }\n\n        .detalles-expandidos .franja-info .fechas {\n            color: #a0aec0;\n            font-size: 0.8rem;\n        }\n\n        .vacio {\n            text-align: center;\n            color: #4a5568;\n            padding: 30px;\n            font-style: italic;\n        }\n\n        footer {\n            text-align: center;\n            padding: 20px;\n            color: #4a5568;\n            font-size: 0.8rem;\n            text-transform: uppercase;\n            letter-spacing: 2px;\n        }\n\n        .disenador {\n            font-size: 0.75rem;\n            margin-top: 4px;\n            color: #718096;\n        }\n\n        .modal {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            background: rgba(0, 0, 0, 0.7);\n            display: none;\n            align-items: center;\n            justify-content: center;\n            z-index: 2000;\n            padding: 20px;\n        }\n\n        .modal.visible {\n            display: flex;\n        }\n\n        .modal-contenido {\n            background: #2d3748;\n            border-radius: 12px;\n            border: 1px solid #4a5568;\n            max-width: 900px;\n            width: 100%;\n            max-height: 90vh;\n            overflow-y: auto;\n            padding: 24px;\n        }\n\n        .modal-header {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            margin-bottom: 16px;\n        }\n\n        .modal-header h2 {\n            margin-bottom: 0;\n            border-bottom: none;\n            padding-bottom: 0;\n        }\n\n        .btn-cerrar-modal {\n            background: none;\n            border: none;\n            color: #a0aec0;\n            font-size: 1.5rem;\n            cursor: pointer;\n            padding: 4px 8px;\n            transition: color 0.2s;\n        }\n\n        .btn-cerrar-modal:hover {\n            color: #e2e8f0;\n        }\n\n        .modal-acciones {\n            display: flex;\n            gap: 10px;\n            margin-bottom: 16px;\n        }\n\n        .btn-exportar, .btn-imprimir {\n            padding: 10px 20px;\n            border: none;\n            border-radius: 6px;\n            cursor: pointer;\n            font-size: 0.85rem;\n            font-weight: 600;\n            transition: all 0.2s;\n            text-transform: uppercase;\n            letter-spacing: 0.5px;\n        }\n\n        .btn-exportar {\n            background: #2f855a;\n            color: white;\n        }\n\n        .btn-exportar:hover {\n            background: #38a169;\n        }\n\n        .btn-imprimir {\n            background: #2b6cb0;\n            color: white;\n        }\n\n        .btn-imprimir:hover {\n            background: #3182ce;\n        }\n\n        .modal-tabla {\n            overflow-x: auto;\n        }\n\n        .modal-tabla table {\n            width: 100%;\n            border-collapse: collapse;\n            font-size: 0.85rem;\n        }\n\n        .modal-tabla th,\n        .modal-tabla td {\n            padding: 10px 12px;\n            text-align: left;\n            border-bottom: 1px solid #4a5568;\n        }\n\n        .modal-tabla th {\n            background: #1a202c;\n            color: #a0aec0;\n            font-weight: 600;\n            text-transform: uppercase;\n            font-size: 0.75rem;\n            letter-spacing: 0.5px;\n        }\n\n        .modal-tabla td {\n            color: #e2e8f0;\n        }\n\n        .modal-tabla tr:hover td {\n            background: rgba(255, 255, 255, 0.03);\n        }\n\n        .modal-tabla .sin-franja {\n            color: #4a5568;\n            font-style: italic;\n        }\n\n        .modal-tabla .dias-restantes {\n            color: #68d391;\n            font-weight: 600;\n        }\n\n        .modal-tabla .dias-agotados {\n            color: #fc8181;\n            font-weight: 600;\n        }\n\n        @media print {\n            body * {\n                visibility: hidden;\n            }\n\n            .modal,\n            .modal * {\n                visibility: visible;\n            }\n\n            .modal {\n                position: absolute;\n                top: 0;\n                left: 0;\n                width: 100%;\n                height: auto;\n                background: white;\n                padding: 0;\n            }\n\n            .modal-contenido {\n                background: white;\n                border: none;\n                max-width: 100%;\n                max-height: none;\n                overflow: visible;\n                color: black;\n            }\n\n            .modal-header h2 {\n                color: black;\n            }\n\n            .modal-acciones {\n                display: none;\n            }\n\n            .btn-cerrar-modal {\n                display: none;\n            }\n\n            .modal-tabla th {\n                background: #e2e8f0;\n                color: black;\n            }\n\n            .modal-tabla td {\n                color: black;\n                border-bottom: 1px solid #ccc;\n            }\n\n            .modal-tabla .sin-franja {\n                color: #666;\n            }\n\n            .modal-tabla .dias-restantes,\n            .modal-tabla .dias-agotados {\n                color: black;\n            }\n        }\n\n        @media (max-width: 480px) {\n            body {\n                padding: 12px;\n            }\n\n            .logo {\n                font-size: 2rem;\n                letter-spacing: 6px;\n            }\n\n            header h1 {\n                font-size: 1rem;\n            }\n\n            .form-section, .list-section {\n                padding: 18px;\n            }\n\n            .form-row {\n                flex-direction: column;\n                gap: 0;\n            }\n\n            .dia {\n                min-height: 40px;\n            }\n\n            .dia .apellido {\n                font-size: 0.55rem;\n            }\n\n            .list-header {\n                flex-direction: column;\n                gap: 10px;\n                align-items: flex-start;\n            }\n\n            .modal-acciones {\n                flex-direction: column;\n            }\n\n            .btn-exportar, .btn-imprimir {\n                width: 100%;\n            }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <div class=\"logo\">ETAC</div>\n            <h1>Cronograma de Licencia anual</h1>\n            <p class=\"subtitle\">Guardia A - BASE PUNILLA</p>\n        </header>\n\n        <section class=\"form-section\">\n            <h2 id=\"formTitulo\">Registrar efectivo</h2>\n            <form id=\"vacationForm\">\n                <input type=\"hidden\" id=\"editandoId\" value=\"\">\n\n                <div class=\"form-group\">\n                    <label for=\"nombre\">Apellido y Nombre</label>\n                    <input type=\"text\" id=\"nombre\" placeholder=\"Ej: García, Juan\" required>\n                </div>\n\n                <div class=\"form-group\">\n                    <label for=\"dni\">DNI</label>\n                    <input type=\"text\" id=\"dni\" placeholder=\"Ej: 30123456\" required>\n                </div>\n\n                <div class=\"form-group\">\n                    <label for=\"diasDisponibles\">Días hábiles disponibles</label>\n                    <input type=\"number\" id=\"diasDisponibles\" min=\"1\" placeholder=\"Ej: 20\" required>\n                </div>\n\n                <div class=\"form-group\">\n                    <label>Primera franja</label>\n                    <div class=\"form-row\">\n                        <div class=\"form-group\">\n                            <label for=\"fechaInicio\">Fecha de inicio</label>\n                            <input type=\"date\" id=\"fechaInicio\" required>\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"diasFranja1\">Días hábiles</label>\n                            <input type=\"number\" id=\"diasFranja1\" min=\"0\" placeholder=\"Ej: 10\">\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"form-group\">\n                    <label>Segunda franja</label>\n                    <div class=\"form-row\">\n                        <div class=\"form-group\">\n                            <label for=\"fechaInicioFranja2\">Fecha de inicio</label>\n                            <input type=\"date\" id=\"fechaInicioFranja2\">\n                        </div>\n                        <div class=\"form-group\">\n                            <label for=\"diasFranja2\">Días hábiles</label>\n                            <input type=\"number\" id=\"diasFranja2\" min=\"0\" placeholder=\"Ej: 5\">\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"form-group\">\n                    <label>Calendario de franjas</label>\n                    <p class=\"help-text\">Los días se asignan automáticamente según la configuración de cada franja.</p>\n                    <div class=\"calendar-nav\">\n                        <button type=\"button\" id=\"mesAnterior\" class=\"btn-nav\">← Anterior</button>\n                        <span id=\"mesActual\" class=\"mes-label\"></span>\n                        <button type=\"button\" id=\"mesSiguiente\" class=\"btn-nav\">Siguiente →</button>\n                    </div>\n                    <div id=\"calendario\" class=\"calendario\"></div>\n                    <div class=\"leyenda\">\n                        <span class=\"item\"><span class=\"cuadrado franja1\"></span> Primera franja</span>\n                        <span class=\"item\"><span class=\"cuadrado franja2\"></span> Segunda franja</span>\n                        <span class=\"item\"><span class=\"cuadrado ocupado\"></span> Ocupado</span>\n                        <span class=\"item\"><span class=\"cuadrado prohibido\"></span> Prohibido</span>\n                        <span class=\"item\"><span class=\"cuadrado feriado\"></span> Feriado</span>\n                    </div>\n                    <p class=\"contador\">\n                        Primera franja: <strong id=\"contadorFranja1\">0</strong> días ·\n                        Segunda franja: <strong id=\"contadorFranja2\">0</strong> días ·\n                        Total: <strong id=\"contadorTotal\">0</strong> días\n                    </p>\n                    <p id=\"ayudaCalendario\" class=\"ayuda-calendario\">Configurá las franjas para ver el calendario.</p>\n                </div>\n\n                <button type=\"submit\" class=\"btn-submit\" id=\"btnSubmit\">Añadir efectivo</button>\n                <button type=\"button\" class=\"btn-cancelar\" id=\"btnCancelar\" style=\"display:none;\">Cancelar edición</button>\n            </form>\n            <p id=\"mensaje\" class=\"mensaje\"></p>\n        </section>\n\n        <section class=\"list-section\">\n            <div class=\"list-header\">\n                <h2>Efectivos registrados</h2>\n                <button type=\"button\" class=\"btn-listado\" id=\"btnListado\">Ver listado</button>\n            </div>\n            <div id=\"lista\" class=\"lista\"></div>\n        </section>\n\n        <footer>\n            <p>ETAC · Guardia A - BASE PUNILLA</p>\n            <p class=\"disenador\">Diseñado por: Maldonado Jorge Matias</p>\n        </footer>\n    </div>\n\n    <div id=\"modalListado\" class=\"modal\">\n        <div class=\"modal-contenido\">\n            <div class=\"modal-header\">\n                <h2>Listado de efectivos</h2>\n                <button type=\"button\" class=\"btn-cerrar-modal\" id=\"btnCerrarModal\">✕</button>\n            </div>\n            <div class=\"modal-acciones\">\n                <button type=\"button\" class=\"btn-exportar\" id=\"btnExportar\">Exportar CSV</button>\n                <button type=\"button\" class=\"btn-imprimir\" id=\"btnImprimir\">Imprimir</button>\n            </div>\n            <div class=\"modal-tabla\">\n                <table id=\"tablaListado\">\n                    <thead>\n                        <tr>\n                            <th>Apellido y Nombre</th>\n                            <th>Días disponibles</th>\n                            <th>Días usados</th>\n                            <th>Días restantes</th>\n                            <th>1ª Franja (Inicio - Fin)</th>\n                            <th>2ª Franja (Inicio - Fin)</th>\n                        </tr>\n                    </thead>\n                    <tbody id=\"cuerpoTabla\"></tbody>\n                </table>\n            </div>\n        </div>\n    </div>\n\n    <div id=\"tooltip\" class=\"tooltip\"></div>\n\n    <script>\n    // ============================================\n    // ETAC - Cronograma de Licencia Anual\n    // Guardia A - BASE PUNILLA\n    // Diseñado por: Maldonado Jorge Matias\n    // ============================================\n\n    const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbw-8IqxVf5pJE0XtF6tqUOij04LRONCuRyMfnUP0uB_f5bpLQ-WUXzSsodgdi-l2Z0Q/exec';\n\n    const FERIADOS = {\n        '2026-12-08': 'Inmaculada Concepción',\n        '2026-12-24': 'Noche Buena',\n        '2026-12-25': 'Navidad',\n        '2026-12-31': 'Año Viejo',\n        '2027-01-01': 'Año Nuevo',\n        '2027-02-08': 'Carnaval',\n        '2027-02-09': 'Carnaval',\n        '2027-03-24': 'Día Nacional de la Memoria por la Verdad y la Justicia',\n        '2027-03-26': 'Viernes Santo',\n        '2027-04-02': 'Día del Veterano y de los Caídos en la Guerra de Malvinas',\n        '2027-05-01': 'Día del Trabajador',\n        '2027-05-25': 'Día de la Revolución de Mayo',\n        '2027-06-20': 'Paso a la Inmortalidad del General Manuel Belgrano',\n    };\n\n    const FECHA_MINIMA = '2026-12-01';\n    const FECHA_MAXIMA = '2027-06-30';\n    const MAX_SIMULTANEAS = 3;\n\n    let mesMostrado = new Date();\n    let editandoId = null;\n    let efectivosCache = [];\n\n    function formatearFechaLocal(fecha) {\n        const año = fecha.getFullYear();\n        const mes = String(fecha.getMonth() + 1).padStart(2, '0');\n        const dia = String(fecha.getDate()).padStart(2, '0');\n        return año + '-' + mes + '-' + dia;\n    }\n\n    function esDiaNoHabil(fechaStr) {\n        const fecha = new Date(fechaStr + 'T00:00:00');\n        const diaSemana = fecha.getDay();\n        return diaSemana === 0 || diaSemana === 6 || FERIADOS.hasOwnProperty(fechaStr);\n    }\n\n    function obtenerDiasHabiles(fechaInicio, fechaFin) {\n        const dias = [];\n        let actual = new Date(fechaInicio + 'T00:00:00');\n        const fin = new Date(fechaFin + 'T00:00:00');\n        while (actual <= fin) {\n            const fechaStr = formatearFechaLocal(actual);\n            if (!esDiaNoHabil(fechaStr)) {\n                dias.push(fechaStr);\n            }\n            actual.setDate(actual.getDate() + 1);\n        }\n        return dias;\n    }\n\n    function obtenerPrimerosDiasHabiles(fechaInicio, cantidad) {\n        const dias = [];\n        let actual = new Date(fechaInicio + 'T00:00:00');\n        let contador = 0;\n        while (contador < cantidad) {\n            const fechaStr = formatearFechaLocal(actual);\n            if (!esDiaNoHabil(fechaStr)) {\n                dias.push(fechaStr);\n                contador++;\n            }\n            actual.setDate(actual.getDate() + 1);\n        }\n        return dias;\n    }\n\n    function contarEnDia(fechaStr, efectivos) {\n        let count = 0;\n        for (let i = 0; i < efectivos.length; i++) {\n            if (efectivos[i].dias.indexOf(fechaStr) !== -1) {\n                count++;\n            }\n        }\n        return count;\n    }\n\n    function obtenerApellidosEnDia(fechaStr, efectivos) {\n        const apellidos = [];\n        for (let i = 0; i < efectivos.length; i++) {\n            if (efectivos[i].dias.indexOf(fechaStr) !== -1) {\n                const nombre = efectivos[i].nombre;\n                const partes = nombre.split(',');\n                apellidos.push(partes[0].trim());\n            }\n        }\n        return apellidos;\n    }\n\n    function obtenerEfectivosEnDia(fechaStr, efectivos) {\n        const personas = [];\n        for (let i = 0; i < efectivos.length; i++) {\n            const ef = efectivos[i];\n            if (ef.dias.indexOf(fechaStr) !== -1) {\n                let franja = '';\n                if (ef.franja1.indexOf(fechaStr) !== -1) {\n                    franja = '1ª franja';\n                } else if (ef.franja2.indexOf(fechaStr) !== -1) {\n                    franja = '2ª franja';\n                }\n                personas.push({ nombre: ef.nombre, franja: franja });\n            }\n        }\n        return personas;\n    }\n\n    function formatearFechaLegible(fechaStr) {\n        if (!fechaStr) return '';\n        const partes = fechaStr.split('-');\n        return partes[2] + '/' + partes[1] + '/' + partes[0];\n    }\n\n    // ============================================\n    // Gestión de datos (Google Sheets)\n    // ============================================\n\n    function cargarEfectivos() {\n        return efectivosCache;\n    }\n\n    async function cargarEfectivosDesdeGoogle() {\n        try {\n            const response = await fetch(SCRIPT_URL + '?action=getAll');\n            const data = await response.json();\n            efectivosCache = data;\n            return efectivosCache;\n        } catch (e) {\n            console.error('Error al cargar datos:', e);\n            return [];\n        }\n    }\n\n    async function agregarEfectivo(nombre, dni, diasDisponibles, fechaInicio, diasF1, fechaInicioFranja2, diasF2) {\n        const calculado = calcularFranjas(fechaInicio, diasF1, fechaInicioFranja2, diasF2);\n        const todosDias = calculado.franja1.concat(calculado.franja2);\n        todosDias.sort();\n\n        const params = new URLSearchParams({\n            action: 'add',\n            nombre: nombre.trim(),\n            dni: dni.trim(),\n            diasDisponibles: diasDisponibles,\n            fechaInicio: fechaInicio,\n            dias: JSON.stringify(todosDias),\n            franja1: JSON.stringify(calculado.franja1),\n            franja2: JSON.stringify(calculado.franja2)\n        });\n\n        try {\n            const response = await fetch(SCRIPT_URL, {\n                method: 'POST',\n                body: params\n            });\n            const result = await response.json();\n            await cargarEfectivosDesdeGoogle();\n            return result;\n        } catch (e) {\n            console.error('Error al agregar:', e);\n            return { error: e.message };\n        }\n    }\n\n    async function actualizarEfectivo(id, nombre, dni, diasDisponibles, fechaInicio, diasF1, fechaInicioF2, diasF2) {\n        const calculado = calcularFranjas(fechaInicio, diasF1, fechaInicioF2, diasF2);\n        const todosDias = calculado.franja1.concat(calculado.franja2);\n        todosDias.sort();\n\n        const params = new URLSearchParams({\n            action: 'update',\n            id: id,\n            nombre: nombre.trim(),\n            dni: dni.trim(),\n            diasDisponibles: diasDisponibles,\n            fechaInicio: fechaInicio,\n            dias: JSON.stringify(todosDias),\n            franja1: JSON.stringify(calculado.franja1),\n            franja2: JSON.stringify(calculado.franja2)\n        });\n\n        try {\n            const response = await fetch(SCRIPT_URL, {\n                method: 'POST',\n                body: params\n            });\n            const result = await response.json();\n            await cargarEfectivosDesdeGoogle();\n            return result;\n        } catch (e) {\n            console.error('Error al actualizar:', e);\n            return { error: e.message };\n        }\n    }\n\n    async function eliminarEfectivo(id) {\n        const params = new URLSearchParams({\n            action: 'delete',\n            id: id\n        });\n\n        try {\n            const response = await fetch(SCRIPT_URL, {\n                method: 'POST',\n                body: params\n            });\n            const result = await response.json();\n            await cargarEfectivosDesdeGoogle();\n            return result;\n        } catch (e) {\n            console.error('Error al eliminar:', e);\n            return { error: e.message };\n        }\n    }\n\n    // ============================================\n    // Calendario\n    // ============================================\n\n    function obtenerDiasDelMes(año, mes) {\n        const primerDia = new Date(año, mes, 1);\n        const ultimoDia = new Date(año, mes + 1, 0);\n        const diasEnMes = ultimoDia.getDate();\n        const diaSemanaInicio = primerDia.getDay();\n        const dias = [];\n        for (let i = 0; i < diaSemanaInicio; i++) {\n            dias.push(null);\n        }\n        for (let d = 1; d <= diasEnMes; d++) {\n            const fecha = new Date(año, mes, d);\n            dias.push(formatearFechaLocal(fecha));\n        }\n        return dias;\n    }\n\n    function obtenerNombreMes(año, mes) {\n        const meses = [\n            'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',\n            'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'\n        ];\n        return meses[mes] + ' ' + año;\n    }\n\n    function calcularFranjas(fechaInicio, diasFranja1, fechaInicioFranja2, diasFranja2) {\n        const franja1 = [];\n        if (fechaInicio && diasFranja1 > 0) {\n            const dias = obtenerPrimerosDiasHabiles(fechaInicio, diasFranja1);\n            for (let i = 0; i < dias.length; i++) {\n                franja1.push(dias[i]);\n            }\n        }\n        const franja2 = [];\n        if (fechaInicioFranja2 && diasFranja2 > 0) {\n            const dias = obtenerPrimerosDiasHabiles(fechaInicioFranja2, diasFranja2);\n            for (let i = 0; i < dias.length; i++) {\n                franja2.push(dias[i]);\n            }\n        }\n        return { franja1: franja1, franja2: franja2 };\n    }\n\n    function renderizarCalendario() {\n        const calendario = document.getElementById('calendario');\n        const mesLabel = document.getElementById('mesActual');\n        const ayuda = document.getElementById('ayudaCalendario');\n        const efectivos = cargarEfectivos();\n\n        const fechaInicio = document.getElementById('fechaInicio').value;\n        const diasF1 = parseInt(document.getElementById('diasFranja1').value, 10) || 0;\n        const fechaInicioF2 = document.getElementById('fechaInicioFranja2').value;\n        const diasF2 = parseInt(document.getElementById('diasFranja2').value, 10) || 0;\n\n        let franja1 = [];\n        let franja2 = [];\n        let hayFranjas = false;\n\n        if (fechaInicio && diasF1 > 0) {\n            const calculado = calcularFranjas(fechaInicio, diasF1, fechaInicioF2, diasF2);\n            franja1 = calculado.franja1;\n            franja2 = calculado.franja2;\n            hayFranjas = true;\n        } else if (fechaInicioF2 && diasF2 > 0) {\n            const calculado = calcularFranjas(fechaInicio, diasF1, fechaInicioF2, diasF2);\n            franja2 = calculado.franja2;\n            hayFranjas = true;\n        }\n\n        if (ayuda) {\n            if (hayFranjas) {\n                ayuda.style.display = 'none';\n            } else {\n                ayuda.style.display = 'block';\n            }\n        }\n\n        const año = mesMostrado.getFullYear();\n        const mes = mesMostrado.getMonth();\n\n        mesLabel.textContent = obtenerNombreMes(año, mes);\n\n        const dias = obtenerDiasDelMes(año, mes);\n        const diasSemana = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];\n\n        let html = '';\n        for (let i = 0; i < diasSemana.length; i++) {\n            html += '<div class=\"dia-header\">' + diasSemana[i] + '</div>';\n        }\n\n        for (let i = 0; i < dias.length; i++) {\n            const fechaStr = dias[i];\n\n            if (!fechaStr) {\n                html += '<div class=\"dia vacio\"></div>';\n                continue;\n            }\n\n            const fecha = new Date(fechaStr + 'T00:00:00');\n            const diaSemana = fecha.getDay();\n            const esFeriado = FERIADOS.hasOwnProperty(fechaStr);\n            const esFinde = diaSemana === 0 || diaSemana === 6;\n\n            const apellidos = obtenerApellidosEnDia(fechaStr, efectivos);\n            const enFranja1 = franja1.indexOf(fechaStr) !== -1;\n            const enFranja2 = franja2.indexOf(fechaStr) !== -1;\n\n            const cantidadEnDia = contarEnDia(fechaStr, efectivos);\n            const esProhibido = cantidadEnDia > MAX_SIMULTANEAS;\n\n            let clase = 'dia ';\n\n            if (esFeriado) {\n                clase += 'feriado';\n            } else if (esFinde) {\n                clase += 'ocupado-otro';\n            } else if (esProhibido) {\n                clase += 'prohibido';\n            } else if (enFranja1) {\n                clase += 'franja1';\n            } else if (enFranja2) {\n                clase += 'franja2';\n            } else if (apellidos.length > 0) {\n                clase += 'ocupado-otro';\n            } else {\n                clase += 'libre';\n            }\n\n            let apellidoHtml = '';\n            if (apellidos.length > 0) {\n                apellidoHtml = '<span class=\"apellido\">' + apellidos.join(', ') + '</span>';\n            }\n\n            html += '<div class=\"' + clase + '\" data-fecha=\"' + fechaStr + '\"><span class=\"numero\">' + fecha.getDate() + '</span>' + apellidoHtml + '</div>';\n        }\n\n        calendario.innerHTML = html;\n\n        const diasConFecha = calendario.querySelectorAll('.dia[data-fecha]');\n        for (let i = 0; i < diasConFecha.length; i++) {\n            diasConFecha[i].addEventListener('mouseenter', mostrarTooltip);\n            diasConFecha[i].addEventListener('mouseleave', ocultarTooltip);\n            diasConFecha[i].addEventListener('click', mostrarTooltip);\n        }\n\n        document.getElementById('contadorFranja1').textContent = franja1.length;\n        document.getElementById('contadorFranja2').textContent = franja2.length;\n        document.getElementById('contadorTotal').textContent = franja1.length + franja2.length;\n    }\n\n    function mostrarTooltip(event) {\n        const fechaStr = event.currentTarget.dataset.fecha;\n        const efectivos = cargarEfectivos();\n        const tooltip = document.getElementById('tooltip');\n\n        const personas = obtenerEfectivosEnDia(fechaStr, efectivos);\n        const esFeriado = FERIADOS.hasOwnProperty(fechaStr);\n        const cantidadEnDia = contarEnDia(fechaStr, efectivos);\n        const esProhibido = cantidadEnDia > MAX_SIMULTANEAS;\n\n        let html = '<div class=\"fecha\">' + formatearFechaLegible(fechaStr) + '</div>';\n\n        if (esFeriado) {\n            html += '<div class=\"feriado\">' + FERIADOS[fechaStr] + '</div>';\n        }\n\n        if (esProhibido) {\n            html += '<div class=\"prohibido\">Supera el cupo (' + cantidadEnDia + ' personas)</div>';\n        }\n\n        if (personas.length === 0) {\n            html += '<div class=\"sin-vacaciones\">Sin licencia</div>';\n        } else {\n            for (let i = 0; i < personas.length; i++) {\n                html += '<div class=\"persona\"><div class=\"nombre\">' + personas[i].nombre + '</div><div class=\"franja\">' + personas[i].franja + '</div></div>';\n            }\n        }\n\n        tooltip.innerHTML = html;\n        tooltip.classList.add('visible');\n\n        const rect = event.currentTarget.getBoundingClientRect();\n        const tooltipRect = tooltip.getBoundingClientRect();\n\n        let left = rect.left + rect.width / 2 - tooltipRect.width / 2;\n        let top = rect.top - tooltipRect.height - 8;\n\n        if (left < 8) left = 8;\n        if (left + tooltipRect.width > window.innerWidth - 8) {\n            left = window.innerWidth - tooltipRect.width - 8;\n        }\n        if (top < 8) top = rect.bottom + 8;\n\n        tooltip.style.left = left + 'px';\n        tooltip.style.top = top + 'px';\n    }\n\n    function ocultarTooltip() {\n        const tooltip = document.getElementById('tooltip');\n        tooltip.classList.remove('visible');\n    }\n\n    function validarFormulario(nombre, dni, diasDisponibles, fechaInicio, diasF1, fechaInicioF2, diasF2) {\n        if (!nombre.trim()) {\n            return 'El apellido y nombre son obligatorios.';\n        }\n\n        if (!dni.trim()) {\n            return 'El DNI es obligatorio.';\n        }\n\n        if (!diasDisponibles || diasDisponibles < 1) {\n            return 'Los días hábiles disponibles son obligatorios y deben ser al menos 1.';\n        }\n\n        if (!fechaInicio) {\n            return 'La fecha de inicio de la primera franja es obligatoria.';\n        }\n\n        if (fechaInicio < FECHA_MINIMA || fechaInicio > FECHA_MAXIMA) {\n            return 'Las fechas deben estar entre el 01/12/2026 y el 30/06/2027.';\n        }\n\n        if (diasF1 < 0) {\n            return 'Los días de la primera franja no pueden ser negativos.';\n        }\n\n        if (fechaInicioF2 || diasF2 > 0) {\n            if (!fechaInicioF2) {\n                return 'Si completás días de la segunda franja, también necesitás la fecha de inicio.';\n            }\n            if (diasF2 <= 0) {\n                return 'Si completás la fecha de la segunda franja, también necesitás los días hábiles.';\n            }\n            if (fechaInicioF2 < FECHA_MINIMA || fechaInicioF2 > FECHA_MAXIMA) {\n                return 'Las fechas deben estar entre el 01/12/2026 y el 30/06/2027.';\n            }\n        }\n\n        const calculado = calcularFranjas(fechaInicio, diasF1, fechaInicioF2, diasF2);\n        const totalDias = calculado.franja1.length + calculado.franja2.length;\n\n        if (totalDias > diasDisponibles) {\n            return 'No podés tomar más días de los que tenés disponibles. Tenés ' + diasDisponibles + ' días y querés