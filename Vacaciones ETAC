              "content": "// ============================================\n// Cronograma de vacaciones - Lógica principal\n// ============================================\n\n// Feriados en España (nacionales) para el período 2026-2027\nconst FERIADOS = [\n    '2026-12-06', // Inmaculada Concepción\n    '2026-12-08', // Inmaculada Concepción (algunas comunidades)\n    '2026-12-25', // Navidad\n    '2027-01-01', // Año Nuevo\n    '2027-01-06', // Reyes\n    '2027-03-25', // Jueves Santo\n    '2027-03-26', // Viernes Santo\n    '2027-05-01', // Día del Trabajador\n];\n\n// Fechas límite del período de vacaciones\nconst FECHA_MINIMA = '2026-12-01';\nconst FECHA_MAXIMA = '2027-06-30';\n\n// Mínimo de días hábiles\nconst MIN_DIAS_HABILES = 15;\n\n// Máximo de personas simultáneas\nconst MAX_SIMULTANEAS = 3;\n\n// Clave para localStorage\nconst STORAGE_KEY = 'vacaciones_efectivos';\n\n// ============================================\n// Funciones de utilidad\n// ============================================\n\n/**\n * Convierte un objeto Date a string YYYY-MM-DD en hora local\n */\nfunction formatearFechaLocal(fecha) {\n    const año = fecha.getFullYear();\n    const mes = String(fecha.getMonth() + 1).padStart(2, '0');\n    const dia = String(fecha.getDate()).padStart(2, '0');\n    return `${año}-${mes}-${dia}`;\n}\n\n/**\n * Suma días hábiles a una fecha (sin contar sábados, domingos ni feriados)\n */\nfunction sumarDiasHabiles(fechaInicio, diasHabiles) {\n    const fecha = new Date(fechaInicio);\n    let diasContados = 0;\n\n    while (diasContados < diasHabiles) {\n        fecha.setDate(fecha.getDate() + 1);\n        const diaSemana = fecha.getDay();\n        const fechaStr = formatearFechaLocal(fecha);\n\n        // Si no es sábado (6), domingo (0) ni feriado, cuenta como día hábil\n        if (diaSemana !== 0 && diaSemana !== 6 && !FERIADOS.includes(fechaStr)) {\n            diasContados++;\n        }\n    }\n\n    return fecha;\n}\n\n/**\n * Verifica si una fecha es fin de semana o feriado\n */\nfunction esDiaNoHabil(fecha) {\n    const diaSemana = fecha.getDay();\n    const fechaStr = formatearFechaLocal(fecha);\n    return diaSemana === 0 || diaSemana === 6 || FERIADOS.includes(fechaStr);\n}\n\n/**\n * Cuántos efectivos hay en una franja específica\n */\nfunction contarEnFranja(franja, efectivos) {\n    return efectivos.filter(e => e.franja === franja).length;\n}\n\n// ============================================\n// Gestión de datos (localStorage)\n// ============================================\n\nfunction cargarEfectivos() {\n    const datos = localStorage.getItem(STORAGE_KEY);\n    return datos ? JSON.parse(datos) : [];\n}\n\nfunction guardarEfectivos(efectivos) {\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(efectivos));\n}\n\n// ============================================\n// Lógica de la aplicación\n// ============================================\n\nfunction validarFormulario(fechaStr, franja, dias) {\n    // Validar franja\n    if (!franja.trim()) {\n        return 'La franja es obligatoria.';\n    }\n\n    // Validar días\n    if (!dias || dias < 1) {\n        return 'Los días deben ser un número mayor que 0.';\n    }\n\n    // Validar fecha dentro del período permitido\n    if (fechaStr < FECHA_MINIMA || fechaStr > FECHA_MAXIMA) {\n        return `La fecha debe estar entre el 01/12/2026 y el 30/06/2027.`;\n    }\n\n    // Validar mínimo de días hábiles\n    if (dias < MIN_DIAS_HABILES) {\n        return `Cada efectivo debe tener al menos ${MIN_DIAS_HABILES} días hábiles.`;\n    }\n\n    return null;\n}\n\nfunction agregarEfectivo(fechaStr, franja, dias) {\n    const efectivos = cargarEfectivos();\n\n    const nuevo = {\n        id: Date.now(),\n        fecha: fechaStr,\n        franja: franja.trim(),\n        dias: parseInt(dias, 10),\n    };\n\n    efectivos.push(nuevo);\n    guardarEfectivos(efectivos);\n}\n\nfunction eliminarEfectivo(id) {\n    const efectivos = cargarEfectivos().filter(e => e.id !== id);\n    guardarEfectivos(efectivos);\n}\n\n// ============================================\n// Renderizado\n// ============================================\n\nfunction renderizarLista() {\n    const lista = document.getElementById('lista');\n    const efectivos = cargarEfectivos();\n\n    if (efectivos.length === 0) {\n        lista.innerHTML = '<p class=\"vacio\">No hay efectivos registrados todavía.</p>';\n        return;\n    }\n\n    // Ordenar alfabéticamente por franja\n    efectivos.sort((a, b) => a.franja.localeCompare(b.franja, 'es'));\n\n    lista.innerHTML = efectivos.map(ef => {\n        const prohibido = contarEnFranja(ef.franja, efectivos) > MAX_SIMULTANEAS;\n        const clase = prohibido ? 'prohibido' : '';\n        const circulo = prohibido ? '<span class=\"circulo\"></span>' : '';\n        const badge = prohibido ? '<span class=\"badge\">Prohibido</span>' : '';\n\n        // Calcular fecha fin sumando días hábiles\n        const fechaInicio = new Date(ef.fecha + 'T00:00:00');\n        const fechaFin = sumarDiasHabiles(fechaInicio, ef.dias);\n        const fechaFinStr = formatearFechaLocal(fechaFin);\n\n        return `\n            <div class=\"efectivo ${clase}\">\n                ${circulo}\n                <div class=\"info\">\n                    <div class=\"nombre\">${ef.franja}</div>\n                    <div class=\"detalles\">\n                        Inicio: ${ef.fecha} · Fin: ${fechaFinStr} · ${ef.dias} días hábiles\n                    </div>\n                </div>\n                ${badge}\n            </div>\n        `;\n    }).join('');\n}\n\nfunction mostrarMensaje(texto, tipo) {\n    const msg = document.getElementById('mensaje');\n    msg.textContent = texto;\n    msg.className = `mensaje ${tipo}`;\n\n    // Ocultar después de 4 segundos\n    setTimeout(() => {\n        msg.className = 'mensaje';\n    }, 4000);\n}\n\n// ============================================\n// Inicialización\n// ============================================\n\nfunction init() {\n    // Establecer fecha de hoy por defecto\n    const hoy = new Date();\n    document.getElementById('fecha').value = formatearFechaLocal(hoy);\n\n    // Manejar envío del formulario\n    document.getElementById('vacationForm').addEventListener('submit', (e) => {\n        e.preventDefault();\n\n        const fecha = document.getElementById('fecha').value;\n        const franja = document.getElementById('franja').value;\n        const dias = document.getElementById('dias').value;\n\n        const error = validarFormulario(fecha, franja, dias);\n\n        if (error) {\n            mostrarMensaje(error, 'error');\n            return;\n        }\n\n        agregarEfectivo(fecha, franja, dias);\n        renderizarLista();\n        mostrarMensaje('Efectivo registrado correctamente.', 'exito');\n\n        // Limpiar campos (mantener fecha de hoy)\n        document.getElementById('franja').value = '';\n        document.getElementById('dias').value = '';\n        document.getElementById('fecha').value = formatearFechaLocal(new Date());\n    });\n\n    // Renderizar lista inicial\n    renderizarLista();\n}\n\n// Arrancar cuando el DOM esté listo\ndocument.addEventListener('DOMContentLoaded', init);\n"
