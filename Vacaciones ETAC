placeholder {\n    color: #4a5568;\n}\n\n.help-text {\n    font-size: 0.8rem;\n    color: #718096;\n    margin-bottom: 10px;\n}\n\n.calendar-nav {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-bottom: 12px;\n}\n\n.btn-nav {\n    padding: 8px 14px;\n    background: #1a202c;\n    border: 1px solid #4a5568;\n    border-radius: 6px;\n    cursor: pointer;\n    font-size: 0.8rem;\n    color: #a0aec0;\n    transition: all 0.2s;\n}\n\n.btn-nav:hover {\n    background: #2d3748;\n    color: #e2e8f0;\n}\n\n.mes-label {\n    font-weight: 600;\n    color: #e2e8f0;\n    font-size: 0.95rem;\n}\n\n.calendario {\n    display: grid;\n    grid-template-columns: repeat(7, minmax(0, 1fr));\n    gap: 3px;\n    margin-bottom: 12px;\n    width: 100%;\n    table-layout: fixed;\n}\n\n.dia-header {\n    text-align: center;\n    font-size: 0.7rem;\n    font-weight: 600;\n    color: #718096;\n    padding: 6px 0;\n    text-transform: uppercase;\n}\n\n.dia {\n    min-height: 50px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    border-radius: 6px;\n    font-size: 0.85rem;\n    padding: 2px;\n}\n\n.dia.vacio {\n    background: transparent;\n    min-height: 0;\n}\n\n.dia.libre {\n    background: #1a202c;\n    color: #4a5568;\n}\n\n.dia.franja1 {\n    background: #2b6cb0;\n    color: #ffffff;\n    font-weight: 600;\n}\n\n.dia.franja2 {\n    background: #2f855a;\n    color: #ffffff;\n    font-weight: 600;\n}\n\n.dia.ocupado-otro {\n    background: #742a2a;\n    color: #feb2b2;\n}\n\n.dia.feriado {\n    background: #744210;\n    color: #fbd38d;\n}\n\n.dia .numero {\n    font-weight: 600;\n    font-size: 0.85rem;\n}\n\n.dia .apellido {\n    font-size: 0.6rem;\n    margin-top: 1px;\n    text-align: center;\n    line-height: 1;\n    max-width: 100%;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n}\n\n.dia.franja1 .apellido,\n.dia.franja2 .apellido {\n    color: rgba(255,255,255,0.85);\n}\n\n.dia.ocupado-otro .apellido {\n    color: #feb2b2;\n}\n\n.leyenda {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 12px;\n    margin-bottom: 10px;\n}\n\n.item {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 0.75rem;\n    color: #a0aec0;\n}\n\n.cuadrado {\n    width: 12px;\n    height: 12px;\n    border-radius: 3px;\n    display: inline-block;\n}\n\n.cuadrado.franja1 { background: #2b6cb0; }\n.cuadrado.franja2 { background: #2f855a; }\n.cuadrado.ocupado { background: #742a2a; }\n.cuadrado.feriado { background: #744210; }\n\n.contador {\n    font-size: 0.85rem;\n    color: #a0aec0;\n}\n\n.contador strong {\n    color: #e2e8f0;\n}\n\n.ayuda-calendario {\n    font-size: 0.8rem;\n    color: #63b3ed;\n    margin-top: 8px;\n    font-style: italic;\n}\n\n.btn-submit {\n    width: 100%;\n    padding: 14px;\n    background: linear-gradient(135deg, #2b6cb0 0%, #2c5282 100%);\n    color: white;\n    border: none;\n    border-radius: 8px;\n    font-size: 0.95rem;\n    font-weight: 600;\n    cursor: pointer;\n    transition: all 0.2s;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n}\n\n.btn-submit:hover {\n    background: linear-gradient(135deg, #3182ce 0%, #2b6cb0 100%);\n    transform: translateY(-1px);\n}\n\n.btn-cancelar {\n    width: 100%;\n    padding: 12px;\n    background: #1a202c;\n    color: #a0aec0;\n    border: 1px solid #4a5568;\n    border-radius: 8px;\n    font-size: 0.9rem;\n    font-weight: 600;\n    cursor: pointer;\n    margin-top: 8px;\n    transition: all 0.2s;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n}\n\n.btn-cancelar:hover {\n    background: #2d3748;\n    color: #e2e8f0;\n}\n\n.mensaje {\n    margin-top: 12px;\n    padding: 12px;\n    border-radius: 8px;\n    font-size: 0.85rem;\n    display: none;\n}\n\n.mensaje.error {\n    display: block;\n    background: #742a2a;\n    color: #feb2b2;\n    border: 1px solid #9b2c2c;\n}\n\n.mensaje.exito {\n    display: block;\n    background: #276749;\n    color: #9ae6b4;\n    border: 1px solid #2f855a;\n}\n\n.lista {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n}\n\n.efectivo {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 14px 16px;\n    background: #1a202c;\n    border-radius: 8px;\n    border-left: 4px solid #2b6cb0;\n}\n\n.efectivo.prohibido {\n    border-left-color: #c53030;\n    background: #2d1b1b;\n}\n\n.circulo {\n    width: 12px;\n    height: 12px;\n    border-radius: 50%;\n    background: #c53030;\n    flex-shrink: 0;\n    display: none;\n}\n\n.efectivo.prohibido .circulo {\n    display: block;\n}\n\n.info {\n    flex: 1;\n}\n\n.info .nombre {\n    font-weight: 600;\n    color: #e2e8f0;\n    font-size: 0.95rem;\n}\n\n.info .detalles {\n    font-size: 0.8rem;\n    color: #718096;\n    margin-top: 2px;\n}\n\n.badge {\n    font-size: 0.7rem;\n    padding: 4px 10px;\n    border-radius: 4px;\n    font-weight: 600;\n    background: #c53030;\n    color: white;\n    display: none;\n    text-transform: uppercase;\n}\n\n.efectivo.prohibido .badge {\n    display: inline-block;\n}\n\n.btn-eliminar {\n    padding: 6px 12px;\n    background: #742a2a;\n    color: #feb2b2;\n    border: none;\n    border-radius: 6px;\n    cursor: pointer;\n    font-size: 0.75rem;\n    font-weight: 600;\n    transition: background 0.2s;\n    text-transform: uppercase;\n}\n\n.btn-eliminar:hover {\n    background: #9b2c2c;\n}\n\n.btn-editar {\n    padding: 6px 12px;\n    background: #2b6cb0;\n    color: #bee3f8;\n    border: none;\n    border-radius: 6px;\n    cursor: pointer;\n    font-size: 0.75rem;\n    font-weight: 600;\n    transition: background 0.2s;\n    text-transform: uppercase;\n}\n\n.btn-editar:hover {\n    background: #3182ce;\n}\n\n.btn-detalles {\n    padding: 6px 12px;\n    background: #2d3748;\n    color: #a0aec0;\n    border: 1px solid #4a5568;\n    border-radius: 6px;\n    cursor: pointer;\n    font-size: 0.75rem;\n    font-weight: 600;\n    transition: all 0.2s;\n    text-transform: uppercase;\n}\n\n.btn-detalles:hover {\n    background: #4a5568;\n    color: #e2e8f0;\n}\n\n.detalles-expandidos {\n    margin-top: 10px;\n    padding: 14px;\n    background: #1a202c;\n    border-radius: 8px;\n    border: 1px solid #4a5568;\n    display: none;\n}\n\n.detalles-expandidos.visible {\n    display: block;\n}\n\n.detalles-expandidos h3 {\n    font-size: 0.85rem;\n    color: #a0aec0;\n    margin-bottom: 10px;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n}\n\n.detalles-expandidos .franja-info {\n    margin-bottom: 10px;\n    padding: 10px;\n    border-radius: 6px;\n    font-size: 0.85rem;\n}\n\n.detalles-expandidos .franja-info.franja1 {\n    background: rgba(43, 108, 176, 0.15);\n    border-left: 3px solid #2b6cb0;\n}\n\n.detalles-expandidos .franja-info.franja2 {\n    background: rgba(47, 133, 90, 0.15);\n    border-left: 3px solid #2f855a;\n}\n\n.detalles-expandidos .franja-info .titulo {\n    font-weight: 600;\n    margin-bottom: 4px;\n}\n\n.detalles-expandidos .franja-info.franja1 .titulo {\n    color: #63b3ed;\n}\n\n.detalles-expandidos .franja-info.franja2 .titulo {\n    color: #68d391;\n}\n\n.detalles-expandidos .franja-info .fechas {\n    color: #a0aec0;\n    font-size: 0.8rem;\n}\n\n.vacio {\n    text-align: center;\n    color: #4a5568;\n    padding: 30px;\n    font-style: italic;\n}\n\nfooter {\n    text-align: center;\n    padding: 20px;\n    color: #4a5568;\n    font-size: 0.8rem;\n    text-transform: uppercase;\n    letter-spacing: 2px;\n}\n\n@media (max-width: 480px) {\n    body {\n        padding: 12px;\n    }\n\n    .logo {\n        font-size: 2rem;\n        letter-spacing: 6px;\n    }\n\n    header h1 {\n        font-size: 1rem;\n    }\n\n    .form-section, .list-section {\n        padding: 18px;\n    }\n\n    .form-row {\n        flex-direction: column;\n        gap: 0;\n    }\n\n    .dia {\n        min-height: 40px;\n    }\n\n    .dia .apellido {\n        font-size: 0.55rem;\n    }\n}\n"
