              "content": "// ============================================\n// Cronograma de vacaciones - Lógica principal\n// ============================================\n\n// Feriados nacionales de Argentina (período 2026-2027)\nconst FERIADOS = [\n    '2026-12-08', // Inmaculada Concepción\n    '2026-12-25', // Navidad\n    '2027-01-01', // Año Nuevo\n    '2027-02-08', // Carnaval\n    '2027-02-09', // Carnaval\n    '2027-03-24', // Día Nacional de la Memoria por la Verdad y la Justicia\n    '2027-03-26', // Viernes Santo\n    '2027-04-02', // Día del Veterano y de los Caídos en la Guerra de Malvinas\n    '2027-05-01', // Día del Trabajador\n    '2027-05-25', // Día de la Revolución de Mayo\n    '2027-06-20', // Paso a la Inmortalidad del General Manuel Belgrano\n];\n\n// Fechas límite del período de vacaciones\nconst FECHA_MINIMA = '2026-12-01';\nconst FECHA_MAXIMA = '2027-06-30';\n\n// Mínimo de días hábiles\nconst MIN_DIAS_HABILES = 15;\n\n// Máximo de personas simultáneas\nconst MAX_SIMULTANEAS = 3;\n\n// Clave para localStorage\nconst STORAGE_KEY = 'vacaciones_efectivos';\n\n// Estado del calendario\nlet mesMostrado = new Date();\nlet diasSeleccionados = new Set();\n\n// ============================================\n// Funciones de utilidad\n// ============================================\n\n/**\n * Convierte un objeto Date a string YYYY-MM-DD en hora local\n */\nfunction formatearFechaLocal(fecha) {\n    const año = fecha.getFullYear();\n    const mes = String(fecha.getMonth() + 1).padStart(2, '0');\n    const dia = String(fecha.getDate()).padStart(2, '0');\n    return `${año}-${mes}-${dia}`;\n}\n\n/**\n * Verifica si una fecha es fin de semana o feriado\n */\nfunction esDiaNoHabil(fechaStr) {\n    const fecha = new Date(fechaStr + 'T00:00:00');\n    const diaSemana = fecha.getDay();\n    return diaSemana === 0 || diaSemana === 6 || FERIADOS.includes(fechaStr);\n}\n\n/**\n * Cuántos efectivos hay en un día específico\n */\nfunction contarEnDia(fechaStr, efectivos) {\n    return efectivos.filter(e => e.dias.includes(fechaStr)).length;\n}\n\n// ============================================\n// Gestión de datos (localStorage)\n// ============================================\n\nfunction cargarEfectivos() {\n    const datos = localStorage.getItem(STORAGE_KEY);\n    return datos ? JSON.parse(datos) : [];\n}\n\nfunction guardarEfectivos(efectivos) {\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(efectivos));\n}\n\n// ============================================\n// Calendario\n// ============================================\n\nfunction obtenerDiasDelMes(año, mes) {\n    const primerDia = new Date(año, mes, 1);\n    const ultimoDia = new Date(año, mes + 1, 0);\n    const diasEnMes = ultimoDia.getDate();\n    const diaSemanaInicio = primerDia.getDay();\n\n    const dias = [];\n\n    // Espacios vacíos antes del primer día\n    for (let i = 0; i < diaSemanaInicio; i++) {\n        dias.push(null);\n    }\n\n    // Días del mes\n    for (let d = 1; d <= diasEnMes; d++) {\n        const fecha = new Date(año, mes, d);\n        dias.push(formatearFechaLocal(fecha));\n    }\n\n    return dias;\n}\n\nfunction obtenerNombreMes(año, mes) {\n    const meses = [\n        'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',\n        'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'\n    ];\n    return `${meses[mes]} ${año}`;\n}\n\nfunction renderizarCalendario() {\n    const calendario = document.getElementById('calendario');\n    const mesLabel = document.getElementById('mesActual');\n    const efectivos = cargarEfectivos();\n\n    const año = mesMostrado.getFullYear();\n    const mes = mesMostrado.getMonth();\n\n    mesLabel.textContent = obtenerNombreMes(año, mes);\n\n    const dias = obtenerDiasDelMes(año, mes);\n    const diasSemana = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];\n\n    let html = diasSemana.map(d => `<div class=\"dia-header\">${d}</div>`).join('');\n\n    dias.forEach(fechaStr => {\n        if (!fechaStr) {\n            html += '<div class=\"dia vacio\"></div>';\n            return;\n        }\n\n        const fecha = new Date(fechaStr + 'T00:00:00');\n        const diaSemana = fecha.getDay();\n        const esFeriado = FERIADOS.includes(fechaStr);\n        const esFinde = diaSemana === 0 || diaSemana === 6;\n        const esNoHabil = esFeriado || esFinde;\n\n        const ocupadoOtro = contarEnDia(fechaStr, efectivos);\n        const seleccionado = diasSeleccionados.has(fechaStr);\n\n        let clase = 'dia ';\n\n        if (esFeriado) {\n            clase += 'feriado';\n        } else if (esFinde) {\n            clase += 'ocupado-otro';\n        } else if (ocupadoOtro > 0) {\n            clase += 'ocupado-otro';\n        } else if (seleccionado) {\n            clase += 'seleccionado';\n        } else {\n            clase += 'libre';\n        }\n\n        html += `<div class=\"${clase}\" data-fecha=\"${fechaStr}\">${fecha.getDate()}</div>`;\n    });\n\n    calendario.innerHTML = html;\n\n    // Agregar eventos de clic\n    calendario.querySelectorAll('.dia.libre, .dia.seleccionado').forEach(dia => {\n        dia.addEventListener('click', () => {\n            const fecha = dia.dataset.fecha;\n            if (diasSeleccionados.has(fecha)) {\n                diasSeleccionados.delete(fecha);\n            } else {\n                diasSeleccionados.add(fecha);\n            }\n            actualizarContador();\n            renderizarCalendario();\n        });\n    });\n}\n\nfunction actualizarContador() {\n    document.getElementById('contadorDias').textContent = diasSeleccionados.size;\n}\n\n// ============================================\n// Validación\n// ============================================\n\nfunction validarFormulario(nombre, dni, fechaInicio, fechaFin) {\n    if (!nombre.trim()) {\n        return 'El apellido y nombre son obligatorios.';\n    }\n\n    if (!dni.trim()) {\n        return 'El DNI es obligatorio.';\n    }\n\n    if (!fechaInicio || !fechaFin) {\n        return 'Las fechas de inicio y finalización son obligatorias.';\n    }\n\n    if (fechaInicio > fechaFin) {\n        return 'La fecha de inicio no puede ser posterior a la de finalización.';\n    }\n\n    if (fechaInicio < FECHA_MINIMA || fechaFin > FECHA_MAXIMA) {\n        return `Las fechas deben estar entre el 01/12/2026 y el 30/06/2027.`;\n    }\n\n    if (diasSeleccionados.size < MIN_DIAS_HABILES) {\n        return `Debés seleccionar al menos ${MIN_DIAS_HABILES} días hábiles en el calendario.`;\n    }\n\n    return null;\n}\n\n// ============================================\n// Lógica de la aplicación\n// ============================================\n\nfunction agregarEfectivo(nombre, dni, fechaInicio, fechaFin) {\n    const efectivos = cargarEfectivos();\n\n    const nuevo = {\n        id: Date.now(),\n        nombre: nombre.trim(),\n        dni: dni.trim(),\n        fechaInicio: fechaInicio,\n        fechaFin: fechaFin,\n        dias: Array.from(diasSeleccionados).sort(),\n    };\n\n    efectivos.push(nuevo);\n    guardarEfectivos(efectivos);\n}\n\nfunction eliminarEfectivo(id) {\n    const efectivos = cargarEfectivos().filter(e => e.id !== id);\n    guardarEfectivos(efectivos);\n}\n\n// ============================================\n// Renderizado de la lista\n// ============================================\n\nfunction renderizarLista() {\n    const lista = document.getElementById('lista');\n    const efectivos = cargarEfectivos();\n\n    if (efectivos.length === 0) {\n        lista.innerHTML = '<p class=\"vacio\">No hay efectivos registrados todavía.</p>';\n        return;\n    }\n\n    // Ordenar alfabéticamente por nombre\n    efectivos.sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));\n\n    lista.innerHTML = efectivos.map(ef => {\n        // Verificar si algún día tiene más de 3 personas\n        const diasSobrecargados = ef.dias.filter(d => contarEnDia(d, efectivos) > MAX_SIMULTANEAS);\n        const prohibido = diasSobrecargados.length > 0;\n\n        const clase = prohibido ? 'prohibido' : '';\n        const circulo = prohibido ? '<span class=\"circulo\"></span>' : '';\n        const badge = prohibido ? '<span class=\"badge\">Prohibido</span>' : '';\n\n        return `\n            <div class=\"efectivo ${clase}\">\n                ${circulo}\n                <div class=\"info\">\n                    <div class=\"nombre\">${ef.nombre}</div>\n                    <div class=\"detalles\">\n                        DNI: ${ef.dni} · ${ef.fechaInicio} al ${ef.fechaFin} · ${ef.dias.length} días\n                    </div>\n                </div>\n                ${badge}\n                <button class=\"btn-eliminar\" data-id=\"${ef.id}\">Eliminar</button>\n            </div>\n        `;\n    }).join('');\n\n    // Agregar eventos de eliminar\n    lista.querySelectorAll('.btn-eliminar').forEach(btn => {\n        btn.addEventListener('click', () => {\n            eliminarEfectivo(parseInt(btn.dataset.id, 10));\n            renderizarLista();\n            renderizarCalendario();\n        });\n    });\n}\n\nfunction mostrarMensaje(texto, tipo) {\n    const msg = document.getElementById('mensaje');\n    msg.textContent = texto;\n    msg.className = `mensaje ${tipo}`;\n\n    setTimeout(() => {\n        msg.className = 'mensaje';\n    }, 4000);\n}\n\n// ============================================\n// Inicialización\n// ============================================\n\nfunction init() {\n    // Establecer fechas por defecto\n    const hoy = new Date();\n    document.getElementById('fechaInicio').value = formatearFechaLocal(hoy);\n    document.getElementById('fechaFin').value = formatearFechaLocal(hoy);\n\n    // Mes inicial del calendario\n    mesMostrado = new Date(hoy.getFullYear(), hoy.getMonth(), 1);\n\n    // Navegación del calendario\n    document.getElementById('mesAnterior').addEventListener('click', () => {\n        mesMostrado.setMonth(mesMostrado.getMonth() - 1);\n        renderizarCalendario();\n    });\n\n    document.getElementById('mesSiguiente').addEventListener('click', () => {\n        mesMostrado.setMonth(mesMostrado.getMonth() + 1);\n        renderizarCalendario();\n    });\n\n    // Manejar envío del formulario\n    document.getElementById('vacationForm').addEventListener('submit', (e) => {\n        e.preventDefault();\n\n        const nombre = document.getElementById('nombre').value;\n        const dni = document.getElementById('dni').value;\n        const fechaInicio = document.getElementById('fechaInicio').value;\n        const fechaFin = document.getElementById('fechaFin').value;\n\n        const error = validarFormulario(nombre, dni, fechaInicio, fechaFin);\n\n        if (error) {\n            mostrarMensaje(error, 'error');\n            return;\n        }\n\n        agregarEfectivo(nombre, dni, fechaInicio, fechaFin);\n        renderizarLista();\n        renderizarCalendario();\n        mostrarMensaje('Efectivo registrado correctamente.', 'exito');\n\n        // Limpiar formulario\n        document.getElementById('nombre').value = '';\n        document.getElementById('dni').value = '';\n        document.getElementById('fechaInicio').value = formatearFechaLocal(new Date());\n        document.getElementById('fechaFin').value = formatearFechaLocal(new Date());\n        diasSeleccionados.clear();\n        actualizarContador();\n    });\n\n    // Renderizar inicial\n    renderizarCalendario();\n    renderizarLista();\n}\n\n// Arrancar cuando el DOM esté listo\ndocument.addEventListener('DOMContentLoaded', init);\n"
