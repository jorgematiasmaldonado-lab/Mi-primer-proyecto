              "content": "// ============================================\n// ETAC - Cronograma de vacaciones\n// Ministerio de Seguridad\n// ============================================\n\n// Feriados nacionales de Argentina (período 2026-2027)\nconst FERIADOS = [\n    '2026-12-08', // Inmaculada Concepción\n    '2026-12-25', // Navidad\n    '2027-01-01', // Año Nuevo\n    '2027-02-08', // Carnaval\n    '2027-02-09', // Carnaval\n    '2027-03-24', // Día Nacional de la Memoria por la Verdad y la Justicia\n    '2027-03-26', // Viernes Santo\n    '2027-04-02', // Día del Veterano y de los Caídos en la Guerra de Malvinas\n    '2027-05-01', // Día del Trabajador\n    '2027-05-25', // Día de la Revolución de Mayo\n    '2027-06-20', // Paso a la Inmortalidad del General Manuel Belgrano\n];\n\n// Fechas límite del período de vacaciones\nconst FECHA_MINIMA = '2026-12-01';\nconst FECHA_MAXIMA = '2027-06-30';\n\n// Mínimo de días hábiles totales\nconst MIN_DIAS_HABILES = 15;\n\n// Máximo de personas simultáneas\nconst MAX_SIMULTANEAS = 3;\n\n// Clave para localStorage\nconst STORAGE_KEY = 'vacaciones_efectivos';\n\n// Estado del calendario\nlet mesMostrado = new Date();\n\n// ID del efectivo que se está editando (null = no editando)\nlet editandoId = null;\n\n// ============================================\n// Funciones de utilidad\n// ============================================\n\n/**\n * Convierte un objeto Date a string YYYY-MM-DD en hora local\n */\nfunction formatearFechaLocal(fecha) {\n    const año = fecha.getFullYear();\n    const mes = String(fecha.getMonth() + 1).padStart(2, '0');\n    const dia = String(fecha.getDate()).padStart(2, '0');\n    return `${año}-${mes}-${dia}`;\n}\n\n/**\n * Verifica si una fecha es fin de semana o feriado\n */\nfunction esDiaNoHabil(fechaStr) {\n    const fecha = new Date(fechaStr + 'T00:00:00');\n    const diaSemana = fecha.getDay();\n    return diaSemana === 0 || diaSemana === 6 || FERIADOS.includes(fechaStr);\n}\n\n/**\n * Obtiene todos los días hábiles entre dos fechas (inclusive)\n */\nfunction obtenerDiasHabiles(fechaInicio, fechaFin) {\n    const dias = [];\n    let actual = new Date(fechaInicio + 'T00:00:00');\n    const fin = new Date(fechaFin + 'T00:00:00');\n\n    while (actual <= fin) {\n        const fechaStr = formatearFechaLocal(actual);\n        if (!esDiaNoHabil(fechaStr)) {\n            dias.push(fechaStr);\n        }\n        actual.setDate(actual.getDate() + 1);\n    }\n\n    return dias;\n}\n\n/**\n * Obtiene los primeros N días hábiles desde una fecha\n */\nfunction obtenerPrimerosDiasHabiles(fechaInicio, cantidad) {\n    const dias = [];\n    let actual = new Date(fechaInicio + 'T00:00:00');\n    let contador = 0;\n\n    while (contador < cantidad) {\n        const fechaStr = formatearFechaLocal(actual);\n        if (!esDiaNoHabil(fechaStr)) {\n            dias.push(fechaStr);\n            contador++;\n        }\n        actual.setDate(actual.getDate() + 1);\n    }\n\n    return dias;\n}\n\n/**\n * Cuántos efectivos hay en un día específico\n */\nfunction contarEnDia(fechaStr, efectivos) {\n    return efectivos.filter(e => e.dias.includes(fechaStr)).length;\n}\n\n/**\n * Obtiene los apellidos de los efectivos en un día específico\n */\nfunction obtenerApellidosEnDia(fechaStr, efectivos) {\n    return efectivos\n        .filter(e => e.dias.includes(fechaStr))\n        .map(e => e.nombre.split(',')[0].trim());\n}\n\n/**\n * Obtiene los efectivos en un día con su franja\n */\nfunction obtenerEfectivosEnDia(fechaStr, efectivos) {\n    return efectivos\n        .filter(e => e.dias.includes(fechaStr))\n        .map(e => {\n            let franja = '';\n            if (e.franja1.includes(fechaStr)) franja = '1ª franja';\n            else if (e.franja2.includes(fechaStr)) franja = '2ª franja';\n            return { nombre: e.nombre, franja: franja };\n        });\n}\n\n/**\n * Formatea una fecha YYYY-MM-DD a DD/MM/YYYY\n */\nfunction formatearFechaLegible(fechaStr) {\n    if (!fechaStr) return '';\n    const partes = fechaStr.split('-');\n    return `${partes[2]}/${partes[1]}/${partes[0]}`;\n}\n\n// ============================================\n// Gestión de datos (localStorage)\n// ============================================\n\nfunction cargarEfectivos() {\n    const datos = localStorage.getItem(STORAGE_KEY);\n    return datos ? JSON.parse(datos) : [];\n}\n\nfunction guardarEfectivos(efectivos) {\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(efectivos));\n}\n\n// ============================================\n// Calendario\n// ============================================\n\nfunction obtenerDiasDelMes(año, mes) {\n    const primerDia = new Date(año, mes, 1);\n    const ultimoDia = new Date(año, mes + 1, 0);\n    const diasEnMes = ultimoDia.getDate();\n    const diaSemanaInicio = primerDia.getDay();\n\n    const dias = [];\n\n    // Espacios vacíos antes del primer día\n    for (let i = 0; i < diaSemanaInicio; i++) {\n        dias.push(null);\n    }\n\n    // Días del mes\n    for (let d = 1; d <= diasEnMes; d++) {\n        const fecha = new Date(año, mes, d);\n        dias.push(formatearFechaLocal(fecha));\n    }\n\n    return dias;\n}\n\nfunction obtenerNombreMes(año, mes) {\n    const meses = [\n        'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',\n        'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'\n    ];\n    return `${meses[mes]} ${año}`;\n}\n\n/**\n * Calcula los días de cada franja automáticamente\n * Primera franja: primeros N días hábiles desde fechaInicio\n * Segunda franja: primeros M días hábiles desde fechaInicioFranja2\n */\nfunction calcularFranjas(fechaInicio, diasFranja1, fechaInicioFranja2, diasFranja2) {\n    // Primera franja: primeros N días hábiles desde fechaInicio\n    const franja1 = [];\n    if (fechaInicio && diasFranja1 > 0) {\n        franja1.push(...obtenerPrimerosDiasHabiles(fechaInicio, diasFranja1));\n    }\n\n    // Segunda franja: primeros M días hábiles desde fechaInicioFranja2\n    const franja2 = [];\n    if (fechaInicioFranja2 && diasFranja2 > 0) {\n        franja2.push(...obtenerPrimerosDiasHabiles(fechaInicioFranja2, diasFranja2));\n    }\n\n    return { franja1, franja2 };\n}\n\nfunction renderizarCalendario() {\n    const calendario = document.getElementById('calendario');\n    const mesLabel = document.getElementById('mesActual');\n    const ayuda = document.getElementById('ayudaCalendario');\n    const efectivos = cargarEfectivos();\n\n    const fechaInicio = document.getElementById('fechaInicio').value;\n    const diasF1 = parseInt(document.getElementById('diasFranja1').value, 10) || 0;\n    const fechaInicioF2 = document.getElementById('fechaInicioFranja2').value;\n    const diasF2 = parseInt(document.getElementById('diasFranja2').value, 10) || 0;\n\n    let franja1 = [];\n    let franja2 = [];\n    let hayFranjas = false;\n\n    if (fechaInicio && diasF1 > 0) {\n        const calculado = calcularFranjas(fechaInicio, diasF1, fechaInicioF2, diasF2);\n        franja1 = calculado.franja1;\n        franja2 = calculado.franja2;\n        hayFranjas = true;\n    } else if (fechaInicioF2 && diasF2 > 0) {\n        const calculado = calcularFranjas(fechaInicio, diasF1, fechaInicioF2, diasF2);\n        franja2 = calculado.franja2;\n        hayFranjas = true;\n    }\n\n    // Mostrar u ocultar mensaje de ayuda\n    if (ayuda) {\n        ayuda.style.display = hayFranjas ? 'none' : 'block';\n    }\n\n    const año = mesMostrado.getFullYear();\n    const mes = mesMostrado.getMonth();\n\n    mesLabel.textContent = obtenerNombreMes(año, mes);\n\n    const dias = obtenerDiasDelMes(año, mes);\n    const diasSemana = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];\n\n    let html = diasSemana.map(d => `<div class=\"dia-header\">${d}</div>`).join('');\n\n    dias.forEach(fechaStr => {\n        if (!fechaStr) {\n            html += '<div class=\"dia vacio\"></div>';\n            return;\n        }\n\n        const fecha = new Date(fechaStr + 'T00:00:00');\n        const diaSemana = fecha.getDay();\n        const esFeriado = FERIADOS.includes(fechaStr);\n        const esFinde = diaSemana === 0 || diaSemana === 6;\n        const esNoHabil = esFeriado || esFinde;\n\n        const apellidos = obtenerApellidosEnDia(fechaStr, efectivos);\n        const enFranja1 = franja1.includes(fechaStr);\n        const enFranja2 = franja2.includes(fechaStr);\n\n        let clase = 'dia ';\n\n        if (esFeriado) {\n            clase += 'feriado';\n        } else if (esFinde) {\n            clase += 'ocupado-otro';\n        } else if (enFranja1) {\n            clase += 'franja1';\n        } else if (enFranja2) {\n            clase += 'franja2';\n        } else if (apellidos.length > 0) {\n            clase += 'ocupado-otro';\n        } else {\n            clase += 'libre';\n        }\n\n        const apellidoHtml = apellidos.length > 0\n            ? `<span class=\"apellido\">${apellidos.join(', ')}</span>`\n            : '';\n\n        html += `<div class=\"${clase}\" data-fecha=\"${fechaStr}\"><span class=\"numero\">${fecha.getDate()}</span>${apellidoHtml}</div>`;\n    });\n\n    calendario.innerHTML = html;\n\n    // Agregar eventos de tooltip a cada día\n    calendario.querySelectorAll('.dia[data-fecha]').forEach(dia => {\n        dia.addEventListener('mouseenter', mostrarTooltip);\n        dia.addEventListener('mouseleave', ocultarTooltip);\n        dia.addEventListener('click', mostrarTooltip);\n    });\n\n    // Actualizar contadores\n    document.getElementById('contadorFranja1').textContent = franja1.length;\n    document.getElementById('contadorFranja2').textContent = franja2.length;\n    document.getElementById('contadorTotal').textContent = franja1.length + franja2.length;\n}\n\n// ============================================\n// Tooltip\n// ============================================\n\nfunction mostrarTooltip(event) {\n    const fechaStr = event.currentTarget.dataset.fecha;\n    const efectivos = cargarEfectivos();\n    const tooltip = document.getElementById('tooltip');\n\n    const personas = obtenerEfectivosEnDia(fechaStr, efectivos);\n\n    let html = `<div class=\"fecha\">${formatearFechaLegible(fechaStr)}</div>`;\n\n    if (personas.length === 0) {\n        html += '<div class=\"sin-vacaciones\">Sin vacaciones</div>';\n    } else {\n        personas.forEach(p => {\n            html += `<div class=\"persona\"><div class=\"nombre\">${p.nombre}</div><div class=\"franja\">${p.franja}</div></div>`;\n        });\n    }\n\n    tooltip.innerHTML = html;\n    tooltip.classList.add('visible');\n\n    // Posicionar tooltip\n    const rect = event.currentTarget.getBoundingClientRect();\n    const tooltipRect = tooltip.getBoundingClientRect();\n\n    let left = rect.left + rect.width / 2 - tooltipRect.width / 2;\n    let top = rect.top - tooltipRect.height - 8;\n\n    // Ajustar si se sale de la pantalla\n    if (left < 8) left = 8;\n    if (left + tooltipRect.width > window.innerWidth - 8) {\n        left = window.innerWidth - tooltipRect.width - 8;\n    }\n    if (top < 8) top = rect.bottom + 8;\n\n    tooltip.style.left = left + 'px';\n    tooltip.style.top = top + 'px';\n}\n\nfunction ocultarTooltip() {\n    const tooltip = document.getElementById('tooltip');\n    tooltip.classList.remove('visible');\n}\n\n// ============================================\n// Validación\n// ============================================\n\nfunction validarFormulario(nombre, dni, fechaInicio, diasF1, fechaInicioF2, diasF2) {\n    if (!nombre.trim()) {\n        return 'El apellido y nombre son obligatorios.';\n    }\n\n    if (!dni.trim()) {\n        return 'El DNI es obligatorio.';\n    }\n\n    if (!fechaInicio) {\n        return 'La fecha de inicio de la primera franja es obligatoria.';\n    }\n\n    if (fechaInicio < FECHA_MINIMA || fechaInicio > FECHA_MAXIMA) {\n        return `Las fechas deben estar entre el 01/12/2026 y el 30/06/2027.`;\n    }\n\n    if (diasF1 < 0) {\n        return 'Los días de la primera franja no pueden ser negativos.';\n    }\n\n    // Validar segunda franja si se completó\n    if (fechaInicioF2 || diasF2 > 0) {\n        if (!fechaInicioF2) {\n            return 'Si completás días de la segunda franja, también necesitás la fecha de inicio.';\n        }\n        if (diasF2 <= 0) {\n            return 'Si completás la fecha de la segunda franja, también necesitás los días hábiles.';\n        }\n        if (fechaInicioF2 < FECHA_MINIMA || fechaInicioF2 > FECHA_MAXIMA) {\n            return `Las fechas deben estar entre el 01/12/2026 y el 30/06/2027.`;\n        }\n    }\n\n    // Calcular días hábiles totales\n    const calculado = calcularFranjas(fechaInicio, diasF1, fechaInicioF2, diasF2);\n    const totalDias = calculado.franja1.length + calculado.franja2.length;\n\n    if (totalDias < MIN_DIAS_HABILES) {\n        return `El total de días hábiles debe ser al menos ${MIN_DIAS_HABILES}. Tenés ${totalDias} días configurados.`;\n    }\n\n    return null;\n}\n\n// ============================================\n// Lógica de la aplicación\n// ============================================\n\nfunction agregarEfectivo(nombre, dni, fechaInicio, diasF1, fechaInicioF2, diasF2) {\n    const efectivos = cargarEfectivos();\n\n    const calculado = calcularFranjas(fechaInicio, diasF1, fechaInicioF2, diasF2);\n\n    const nuevo = {\n        id: Date.now(),\n        nombre: nombre.trim(),\n        dni: dni.trim(),\n        fechaInicio: fechaInicio,\n        dias: [...calculado.franja1, ...calculado.franja2].sort(),\n        franja1: calculado.franja1,\n        franja2: calculado.franja2,\n    };\n\n    efectivos.push(nuevo);\n    guardarEfectivos(efectivos);\n}\n\nfunction actualizarEfectivo(id, nombre, dni, fechaInicio, diasF1, fechaInicioF2, diasF2) {\n    const efectivos = cargarEfectivos();\n    const index = efectivos.findIndex(e => e.id === id);\n\n    if (index === -1) return;\n\n    const calculado = calcularFranjas(fechaInicio, diasF1, fechaInicioF2, diasF2);\n\n    efectivos[index] = {\n        ...efectivos[index],\n        nombre: nombre.trim(),\n        dni: dni.trim(),\n        fechaInicio: fechaInicio,\n        dias: [...calculado.franja1, ...calculado.franja2].sort(),\n        franja1: calculado.franja1,\n        franja2: calculado.franja2,\n    };\n\n    guardarEfectivos(efectivos);\n}\n\nfunction eliminarEfectivo(id) {\n    const efectivos = cargarEfectivos().filter(e => e.id !== id);\n    guardarEfectivos(efectivos);\n}\n\n// ============================================\n// Renderizado de la lista\n// ============================================\n\nfunction renderizarLista() {\n    const lista = document.getElementById('lista');\n    const efectivos = cargarEfectivos();\n\n    if (efectivos.length === 0) {\n        lista.innerHTML = '<p class=\"vacio\">No hay efectivos registrados todavía.</p>';\n        return;\n    }\n\n    // Ordenar alfabéticamente por nombre\n    efectivos.sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));\n\n    lista.innerHTML = efectivos.map(ef => {\n        // Verificar si algún día tiene más de 3 personas\n        const diasSobrecargados = ef.dias.filter(d => contarEnDia(d, efectivos) > MAX_SIMULTANEAS);\n        const prohibido = diasSobrecargados.length > 0;\n\n        const clase = prohibido ? 'prohibido' : '';\n        const circulo = prohibido ? '<span class=\"circulo\"></span>' : '';\n        const badge = prohibido ? '<span class=\"badge\">Prohibido</span>' : '';\n\n        // Calcular fechas de fin de cada franja\n        const finFranja1 = ef.franja1.length > 0 ? ef.franja1[ef.franja1.length - 1] : null;\n        const finFranja2 = ef.franja2.length > 0 ? ef.franja2[ef.franja2.length - 1] : null;\n\n        return `\n            <div class=\"efectivo ${clase}\">\n                ${circulo}\n                <div class=\"info\">\n                    <div class=\"nombre\">${ef.nombre}</div>\n                    <div class=\"detalles\">\n                        DNI: ${ef.dni} · 1ª franja: ${ef.franja1.length} días · 2ª franja: ${ef.franja2.length} días · Total: ${ef.dias.length} días\n                    </div>\n                </div>\n                ${badge}\n                <button class=\"btn-detalles\" data-id=\"${ef.id}\">Detalles</button>\n                <button class=\"btn-editar\" data-id=\"${ef.id}\">Editar</button>\n                <button class=\"btn-eliminar\" data-id=\"${ef.id}\">Eliminar</button>\n            </div>\n            <div class=\"detalles-expandidos\" id=\"detalles-${ef.id}\">\n                <h3>Detalle de vacaciones</h3>\n                <div class=\"franja-info franja1\">\n                    <div class=\"titulo\">Primera franja</div>\n                    <div class=\"fechas\">\n                        Inicio: ${formatearFechaLegible(ef.fechaInicio)} · Fin: ${formatearFechaLegible(finFranja1)} · ${ef.franja1.length} días hábiles\n                    </div>\n                </div>\n                ${ef.franja2.length > 0 ? `\n                <div class=\"franja-info franja2\">\n                    <div class=\"titulo\">Segunda franja</div>\n                    <div class=\"fechas\">\n                        Inicio: ${formatearFechaLegible(ef.franja2[0])} · Fin: ${formatearFechaLegible(finFranja2)} · ${ef.franja2.length} días hábiles\n                    </div>\n                </div>\n                ` : ''}\n            </div>\n        `;\n    }).join('');\n\n    // Agregar eventos de eliminar\n    lista.querySelectorAll('.btn-eliminar').forEach(btn => {\n        btn.addEventListener('click', () => {\n            eliminarEfectivo(parseInt(btn.dataset.id, 10));\n            renderizarLista();\n            renderizarCalendario();\n        });\n    });\n\n    // Agregar eventos de editar\n    lista.querySelectorAll('.btn-editar').forEach(btn => {\n        btn.addEventListener('click', () => {\n            cargarEfectivoEnFormulario(parseInt(btn.dataset.id, 10));\n        });\n    });\n\n    // Agregar eventos de detalles\n    lista.querySelectorAll('.btn-detalles').forEach(btn => {\n        btn.addEventListener('click', () => {\n            const detalles = document.getElementById(`detalles-${btn.dataset.id}`);\n            if (detalles) {\n                detalles.classList.toggle('visible');\n            }\n        });\n    });\n}\n\n/**\n * Carga los datos de un efectivo en el formulario para editarlo\n */\nfunction cargarEfectivoEnFormulario(id) {\n    const efectivos = cargarEfectivos();\n    const ef = efectivos.find(e => e.id === id);\n\n    if (!ef) return;\n\n    editandoId = id;\n\n    // Cargar datos en el formulario\n    document.getElementById('nombre').value = ef.nombre;\n    document.getElementById('dni').value = ef.dni;\n    document.getElementById('fechaInicio').value = ef.fechaInicio;\n    document.getElementById('diasFranja1').value = ef.franja1.length;\n\n    // Segunda franja\n    if (ef.franja2.length > 0) {\n        document.getElementById('fechaInicioFranja2').value = ef.franja2[0];\n        document.getElementById('diasFranja2').value = ef.franja2.length;\n    } else {\n        document.getElementById('fechaInicioFranja2').value = '';\n        document.getElementById('diasFranja2').value = '';\n    }\n\n    // Cambiar texto del botón y mostrar cancelar\n    document.getElementById('formTitulo').textContent = 'Editar efectivo';\n    document.getElementById('btnSubmit').textContent = 'Guardar cambios';\n    document.getElementById('btnCancelar').style.display = 'block';\n\n    // Actualizar calendario\n    renderizarCalendario();\n\n    // Hacer scroll al formulario\n    document.querySelector('.form-section').scrollIntoView({ behavior: 'smooth' });\n}\n\n/**\n * Cancela la edición y limpia el formulario\n */\nfunction cancelarEdicion() {\n    editandoId = null;\n\n    // Limpiar formulario\n    document.getElementById('nombre').value = '';\n    document.getElementById('dni').value = '';\n    document.getElementById('fechaInicio').value = '2026-12-01';\n    document.getElementById('diasFranja1').value = '';\n    document.getElementById('fechaInicioFranja2').value = '2027-02-01';\n    document.getElementById('diasFranja2').value = '';\n\n    // Restaurar texto del botón\n    document.getElementById('formTitulo').textContent = 'Registrar efectivo';\n    document.getElementById('btnSubmit').textContent = 'Añadir efectivo';\n    document.getElementById('btnCancelar').style.display = 'none';\n\n    renderizarCalendario();\n}\n\nfunction mostrarMensaje(texto, tipo) {\n    const msg = document.getElementById('mensaje');\n    msg.textContent = texto;\n    msg.className = `mensaje ${tipo}`;\n\n    setTimeout(() => {\n        msg.className = 'mensaje';\n    }, 5000);\n}\n\n// ============================================\n// Inicialización\n// ============================================\n\nfunction init() {\n    // Establecer fechas por defecto\n    document.getElementById('fechaInicio').value = '2026-12-01';\n    document.getElementById('fechaInicioFranja2').value = '2027-02-01';\n\n    // Mes inicial del calendario\n    mesMostrado = new Date(2026, 11, 1); // Diciembre 2026\n\n    // Navegación del calendario\n    document.getElementById('mesAnterior').addEventListener('click', () => {\n        mesMostrado.setMonth(mesMostrado.getMonth() - 1);\n        renderizarCalendario();\n    });\n\n    document.getElementById('mesSiguiente').addEventListener('click', () => {\n        mesMostrado.setMonth(mesMostrado.getMonth() + 1);\n        renderizarCalendario();\n    });\n\n    // Actualizar calendario cuando cambian las fechas o días\n    ['fechaInicio', 'diasFranja1', 'fechaInicioFranja2', 'diasFranja2'].forEach(id => {\n        document.getElementById(id).addEventListener('input', renderizarCalendario);\n    });\n\n    // Botón cancelar edición\n    document.getElementById('btnCancelar').addEventListener('click', cancelarEdicion);\n\n    // Manejar envío del formulario\n    document.getElementById('vacationForm').addEventListener('submit', (e) => {\n        e.preventDefault();\n\n        const nombre = document.getElementById('nombre').value;\n        const dni = document.getElementById('dni').value;\n        const fechaInicio = document.getElementById('fechaInicio').value;\n        const diasF1 = parseInt(document.getElementById('diasFranja1').value, 10) || 0;\n        const fechaInicioF2 = document.getElementById('fechaInicioFranja2').value;\n        const diasF2 = parseInt(document.getElementById('diasFranja2').value, 10) || 0;\n\n        const error = validarFormulario(nombre, dni, fechaInicio, diasF1, fechaInicioF2, diasF2);\n\n        if (error) {\n            mostrarMensaje(error, 'error');\n            return;\n        }\n\n        if (editandoId !== null) {\n            // Actualizar efectivo existente\n            actualizarEfectivo(editandoId, nombre, dni, fechaInicio, diasF1, fechaInicioF2, diasF2);\n            mostrarMensaje('Efectivo actualizado correctamente.', 'exito');\n            cancelarEdicion();\n        } else {\n            // Agregar nuevo efectivo\n            agregarEfectivo(nombre, dni, fechaInicio, diasF1, fechaInicioF2, diasF2);\n            mostrarMensaje('Efectivo registrado correctamente.', 'exito');\n\n            // Limpiar formulario\n            document.getElementById('nombre').value = '';\n            document.getElementById('dni').value = '';\n            document.getElementById('fechaInicio').value = '2026-12-01';\n            document.getElementById('diasFranja1').value = '';\n            document.getElementById('fechaInicioFranja2').value = '2027-02-01';\n            document.getElementById('diasFranja2').value = '';\n        }\n\n        renderizarLista();\n        renderizarCalendario();\n    });\n\n    // Renderizar inicial\n    renderizarCalendario();\n    renderizarLista();\n}\n\n// Arrancar cuando el DOM esté listo\ndocument.addEventListener('DOMContentLoaded', init);\n"
