              "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Cronograma de vacaciones</title>\n    <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n    <div class=\"container\">\n        <header>\n            <h1>🌴 Cronograma de vacaciones</h1>\n            <p class=\"subtitle\">Registra y organiza las vacaciones de tu equipo</p>\n        </header>\n\n        <section class=\"form-section\">\n            <h2>Registrar efectivo</h2>\n            <form id=\"vacationForm\">\n                <div class=\"form-group\">\n                    <label for=\"nombre\">Apellido y Nombre</label>\n                    <input type=\"text\" id=\"nombre\" placeholder=\"Ej: García, Juan\" required>\n                </div>\n\n                <div class=\"form-group\">\n                    <label for=\"dni\">DNI</label>\n                    <input type=\"text\" id=\"dni\" placeholder=\"Ej: 30123456\" required>\n                </div>\n\n                <div class=\"form-row\">\n                    <div class=\"form-group\">\n                        <label for=\"fechaInicio\">Fecha de inicio</label>\n                        <input type=\"date\" id=\"fechaInicio\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"fechaFin\">Fecha de finalización</label>\n                        <input type=\"date\" id=\"fechaFin\" required>\n                    </div>\n                </div>\n\n                <div class=\"form-row\">\n                    <div class=\"form-group\">\n                        <label for=\"diasFranja1\">Días primera franja</label>\n                        <input type=\"number\" id=\"diasFranja1\" min=\"0\" placeholder=\"Ej: 10\">\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"diasFranja2\">Días segunda franja</label>\n                        <input type=\"number\" id=\"diasFranja2\" min=\"0\" placeholder=\"Ej: 5\">\n                    </div>\n                </div>\n\n                <div class=\"form-group\">\n                    <label>Calendario de franjas</label>\n                    <p class=\"help-text\">Los días se asignan automáticamente según la cantidad de días de cada franja.</p>\n                    <div class=\"calendar-nav\">\n                        <button type=\"button\" id=\"mesAnterior\" class=\"btn-nav\">← Anterior</button>\n                        <span id=\"mesActual\" class=\"mes-label\"></span>\n                        <button type=\"button\" id=\"mesSiguiente\" class=\"btn-nav\">Siguiente →</button>\n                    </div>\n                    <div id=\"calendario\" class=\"calendario\"></div>\n                    <div class=\"leyenda\">\n                        <span class=\"item\"><span class=\"cuadrado franja1\"></span> Primera franja</span>\n                        <span class=\"item\"><span class=\"cuadrado franja2\"></span> Segunda franja</span>\n                        <span class=\"item\"><span class=\"cuadrado ocupado\"></span> Ocupado</span>\n                        <span class=\"item\"><span class=\"cuadrado feriado\"></span> Feriado</span>\n                    </div>\n                    <p class=\"contador\">\n                        Primera franja: <strong id=\"contadorFranja1\">0</strong> días ·\n                        Segunda franja: <strong id=\"contadorFranja2\">0</strong> días ·\n                        Total: <strong id=\"contadorTotal\">0</strong> días\n                    </p>\n                    <p id=\"ayudaCalendario\" class=\"ayuda-calendario\">👆 Ingresá los días de cada franja para ver el calendario.</p>\n                </div>\n\n                <button type=\"submit\" class=\"btn-submit\">Añadir efectivo</button>\n            </form>\n            <p id=\"mensaje\" class=\"mensaje\"></p>\n        </section>\n\n        <section class=\"list-section\">\n            <h2>Efectivos registrados</h2>\n            <div id=\"lista\" class=\"lista\"></div>\n        </section>\n    </div>\n\n    <script src=\"app.js\"></script>\n</body>\n</html>\n"
