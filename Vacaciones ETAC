gin-top: 12px;\n    padding: 12px;\n    border-radius: 8px;\n    font-size: 0.9rem;\n    display: none;\n}\n\n.mensaje.error {\n    display: block;\n    background: #fed7d7;\n    color: #c53030;\n}\n\n.mensaje.exito {\n    display: block;\n    background: #c6f6d5;\n    color: #276749;\n}\n\n.lista {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n}\n\n.efectivo {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 14px 16px;\n    background: #f7fafc;\n    border-radius: 12px;\n    border-left: 4px solid #667eea;\n}\n\n.efectivo.prohibido {\n    border-left-color: #e53e3e;\n    background: #fff5f5;\n}\n\n.circulo {\n    width: 14px;\n    height: 14px;\n    border-radius: 50%;\n    background: #e53e3e;\n    flex-shrink: 0;\n    display: none;\n}\n\n.efectivo.prohibido .circulo {\n    display: block;\n}\n\n.info {\n    flex: 1;\n}\n\n.info .nombre {\n    font-weight: 600;\n    color: #2d3748;\n}\n\n.info .detalles {\n    font-size: 0.85rem;\n    color: #718096;\n    margin-top: 2px;\n}\n\n.badge {\n    font-size: 0.75rem;\n    padding: 4px 10px;\n    border-radius: 20px;\n    font-weight: 600;\n    background: #e53e3e;\n    color: white;\n    display: none;\n}\n\n.efectivo.prohibido .badge {\n    display: inline-block;\n}\n\n.btn-eliminar {\n    padding: 6px 12px;\n    background: #fed7d7;\n    color: #c53030;\n    border: none;\n    border-radius: 8px;\n    cursor: pointer;\n    font-size: 0.8rem;\n    font-weight: 600;\n    transition: background 0.2s;\n}\n\n.btn-eliminar:hover {\n    background: #feb2b2;\n}\n\n.vacio {\n    text-align: center;\n    color: #a0aec0;\n    padding: 30px;\n    font-style: italic;\n}\n\n@media (max-width: 480px) {\n    body {\n        padding: 12px;\n    }\n\n    header h1 {\n        font-size: 1.5rem;\n    }\n\n    .form-section, .list-section {\n        padding: 18px;\n    }\n\n    .form-row {\n        flex-direction: column;\n        gap: 0;\n    }\n}\n"
